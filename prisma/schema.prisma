// Prisma es la fuente de verdad del esquema/migraciones. El backend Python
// (ver backend/app/core/db.py) accede a Postgres directo con psycopg + SQL
// plano contra las tablas que este schema crea via "prisma migrate" — no usa
// prisma-client-py (su motor bundleado todavia exige "url" dentro de
// datasource, que Prisma 7 ya no permite aca; la conexion real se configura
// en prisma.config.ts via DATABASE_URL). El generator "prisma-client-js" de
// abajo solo produce tipos de TypeScript para el frontend.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ---------- Enums ----------

enum RolUsuario {
  ADMIN
  DESPACHOS
  APROBADOR
  REPARTIDOR
  VENDEDOR // ve los despachos de sus rutas de venta y registra sus visitas
}

enum Empresa {
  ISVAN
  TRALOG
}

enum AccionRevision {
  APROBADA
  RECHAZADA
}

enum EstadoDespacho {
  BORRADOR
  PENDIENTE_APROBACION
  APROBADO
  RECHAZADO
  EN_PREPARACION
  EN_TRANSITO
  ENTREGADO
  CANCELADO
}

enum EstadoRuta {
  PLANIFICADA
  EN_TRANSITO
  COMPLETADA
  CANCELADA
}

enum TipoVehiculo {
  CAMION_REFRIGERADO
  CAMIONETA
  MOTO
}

enum EstadoVehiculo {
  FUNCIONAL
  EN_MANTENIMIENTO
  FUERA_DE_SERVICIO
}

enum EstadoCargaVenta {
  PENDIENTE // analizada, esperando que el ADMIN la confirme
  CONFIRMADA // cuenta en los indicadores
  REVERTIDA // deshecha; queda solo como registro
}

enum TipoMovimientoVenta {
  VENTA // FA (factura) y NE (nota de entrega)
  DEVOLUCION // DV y DN, con montos negativos
}

// ---------- Usuarios / autenticacion ----------

model Usuario {
  id           String     @id @default(cuid())
  nombre       String
  email        String     @unique
  passwordHash String
  rol          RolUsuario
  avatarUrl    String?
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  // Solo tiene sentido para el rol REPARTIDOR: el vehiculo que maneja. Es
  // lo que acota lo que ese usuario puede ver — su vehiculo lleva una sola
  // ruta activa a la vez, y esa es la unica ruta a la que tiene acceso (ver
  // backend/app/core/permisos.py). Nullable porque los demas roles no lo
  // usan, y porque un repartidor puede quedar sin vehiculo asignado.
  vehiculoAsignadoId String?
  vehiculoAsignado   Vehiculo? @relation("ConductorDelVehiculo", fields: [vehiculoAsignadoId], references: [id])

  despachosCreados     Despacho[]           @relation("DespachosCreadosPor")
  aprobacionesDespacho DespachoAprobacion[]
  rutasCreadas         Ruta[]               @relation("RutasCreadas")
  rutasCanceladas      Ruta[]               @relation("RutasCanceladas")
  sesiones             Sesion[]
  cargasVenta          VentaCarga[]
  // Solo rol VENDEDOR: sus rutas de venta y las visitas que registra.
  rutasVenta           VendedorRuta[]
  visitas              Visita[]
}

// Sesiones respaldadas en BD (no JWT): revocar una sesion es borrar la fila,
// lo cual conviene para un equipo pequeno donde puede hacer falta cerrar la
// sesion de alguien a mano. El token crudo nunca se guarda, solo su hash.
model Sesion {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  tokenHash String   @unique
  creadoEn  DateTime @default(now())
  expiraEn  DateTime
}

// ---------- Almacen y flota ----------

model Almacen {
  id            String  @id @default(cuid())
  nombre        String
  tipo          String // "Centro de Distribucion" | "Planta" | "Tienda"
  direccion     String
  ciudad        String
  lat           Float
  lng           Float
  esFrigorifico Boolean @default(true)

  despachosOrigen Despacho[] @relation("DespachoOrigen")
  vehiculos       Vehiculo[]
  rutas           Ruta[]
}

model Vehiculo {
  id                 String         @id @default(cuid())
  placa              String         @unique
  tipo               TipoVehiculo
  capacidadKg        Float
  tieneRefrigeracion Boolean        @default(true)
  estado             EstadoVehiculo @default(FUNCIONAL)
  almacenBaseId      String
  almacenBase        Almacen        @relation(fields: [almacenBaseId], references: [id])
  conductorNombre    String?
  ultimaRevision     DateTime?
  // Costo operativo por kilometro (USD) usado para estimar el costo de una
  // ruta sugerida. Opcional: si no esta cargado se usa un valor de
  // referencia por tipo de vehiculo (ver plan_rutas.COSTO_POR_KM_POR_TIPO).
  costoPorKm         Float?

  rutas       Ruta[]
  conductores Usuario[] @relation("ConductorDelVehiculo")
}

// ---------- Clientes ----------

// El mismo codigo puede referirse a clientes distintos segun la empresa
// (ISVAN / TRALOG comparten almacen y flota pero no su cartera de clientes),
// asi que la llave de negocio es (empresa, codigo), no el codigo solo.
model Cliente {
  id        String  @id @default(cuid())
  empresa   Empresa
  codigo    String // ej. "CLI-0001", unico solo dentro de su empresa
  nombre    String
  tipo      String // "Tienda" | "Distribuidor" | "Consumidor final"
  direccion String
  ciudad    String
  lat       Float?
  lng       Float?
  // Obligatorio: lo usan los despachadores para contactar al cliente.
  telefono  String
  email     String?
  // Ruta comercial (de venta/reparto) a la que el negocio asigna al cliente,
  // p.ej. "R-07". No es la Ruta (viaje) de este sistema: es un dato del
  // cliente que viene del extracto de ventas y se usa como criterio de peso
  // al sugerir como agrupar despachos en un viaje (ver
  // backend/app/services/plan_rutas.py). Opcional porque hay clientes
  // cargados antes de que existiera la columna.
  rutaComercial String?

  despachos Despacho[] @relation("DespachoDestino")

  @@unique([empresa, codigo])
}

// ---------- Despachos ----------

model Despacho {
  id                   String         @id @default(cuid())
  numero               String         @unique // ej. "D-0001"
  // Numero de factura/nota de entrega del documento origen (Excel o carga
  // manual). Llave real de agrupacion e idempotencia de la importacion: cada
  // documento subido debe ser nuevo, nunca repetir uno ya cargado.
  numeroDocumento      String         @unique
  origenId             String
  origen               Almacen        @relation("DespachoOrigen", fields: [origenId], references: [id])
  destinoClienteId     String
  destinoCliente       Cliente        @relation("DespachoDestino", fields: [destinoClienteId], references: [id])
  creadoPorId          String
  creadoPor            Usuario        @relation("DespachosCreadosPor", fields: [creadoPorId], references: [id])
  estado               EstadoDespacho @default(BORRADOR)
  fechaCreacion        DateTime       @default(now())
  fechaEstimadaEntrega DateTime?

  // El vehiculo se asigna a nivel de Ruta (un vehiculo puede llevar varios
  // despachos en un mismo viaje), no por despacho suelto.
  rutaId      String?
  ruta        Ruta?   @relation(fields: [rutaId], references: [id])
  ordenEnRuta Int? // posicion de esta parada dentro de la ruta, calculada por el TSP

  // Marcas de tiempo que pone el repartidor en la calle, para medir su
  // rendimiento: cuando llego al cliente y cuando termino de entregar. La
  // diferencia entre ambas es el tiempo de atencion de esa parada; entre la
  // entrega anterior y esta llegada, el tiempo de traslado.
  llegadaEn   DateTime?
  entregadoEn DateTime?

  items         DespachoItem[]
  aprobaciones  DespachoAprobacion[]
  puntosEntrega RutaPunto[] // puntos de la ruta marcados como la parada de este despacho
}

model DespachoItem {
  id         String   @id @default(cuid())
  despachoId String
  despacho   Despacho @relation(fields: [despachoId], references: [id])
  // Texto libre (viene del Excel o de carga manual) — ya no hay catalogo de
  // productos: cada fila trae su propia descripcion, cantidad y peso.
  descripcion String
  // Lo que el documento origen pedia originalmente (se copia y se congela al
  // crear el despacho). "cantidad" es lo que realmente se va a despachar: el
  // coordinador puede ajustarla a mano mientras el despacho no haya salido
  // del almacen.
  cantidadSolicitada Int
  cantidad           Int
  pesoUnitarioKg     Float
  requiereFrio       Boolean @default(true)
}

// Auditoria de la aprobacion/rechazo del despacho.
model DespachoAprobacion {
  id         String         @id @default(cuid())
  despachoId String
  despacho   Despacho       @relation(fields: [despachoId], references: [id])
  usuarioId  String
  usuario    Usuario        @relation(fields: [usuarioId], references: [id])
  accion     AccionRevision
  comentario String?
  fecha      DateTime       @default(now())
}

// ---------- Rutas (multi-parada) ----------

// Un viaje de un vehiculo que agrupa varios despachos (uno por cliente),
// visitados en el orden que calcula el optimizador (TSP) a partir de
// Almacen Catia. Reemplaza el calculo "1 despacho = 1 tramo" de antes.
model Ruta {
  id               String     @id @default(cuid())
  numero           String     @unique // ej. "R-0001"
  vehiculoId       String
  vehiculo         Vehiculo   @relation(fields: [vehiculoId], references: [id])
  origenId         String
  origen           Almacen    @relation(fields: [origenId], references: [id])
  creadoPorId      String
  creadoPor        Usuario    @relation("RutasCreadas", fields: [creadoPorId], references: [id])
  estado           EstadoRuta @default(PLANIFICADA)
  fechaCreacion    DateTime   @default(now())
  // Cuando el vehiculo salio del almacen y cuando se entrego la ultima
  // parada. Con estas dos y las marcas de cada Despacho se arma el reporte
  // de rendimiento del viaje (duracion real vs estimada, tiempo hasta la
  // primera parada, tiempo entre paradas).
  iniciadaEn       DateTime?
  completadaEn     DateTime?
  distanciaTotalKm Float?
  tiempoTotalMin   Int?

  // Reverso (solo ADMIN, ver POST /rutas/{id}/reversar): la ruta queda
  // CANCELADA y sus despachos vuelven a "Aprobado" sin ruta. Como al
  // liberarlos se pierde Despacho.rutaId, los numeros que llevaba se
  // guardan aca para que el historial siga diciendo que tenia.
  canceladaEn         DateTime?
  canceladaPorId      String?
  canceladaPor        Usuario?  @relation("RutasCanceladas", fields: [canceladaPorId], references: [id])
  motivoCancelacion   String?
  despachosAlCancelar Json?

  despachos Despacho[]
  puntos    RutaPunto[]
}

// Waypoints de la geometria de una Ruta multi-parada, usados tanto para
// dibujar el trazado calculado como para el seguimiento en vivo.
// paradaDespachoId marca los puntos que corresponden a la llegada/entrega en
// un cliente especifico (a diferencia de los puntos intermedios del trazado).
model RutaPunto {
  id               String    @id @default(cuid())
  rutaId           String
  ruta             Ruta      @relation(fields: [rutaId], references: [id])
  orden            Int
  lat              Float
  lng              Float
  estado           String // "salida" | "en_ruta" | "parada" | "entregado"
  timestamp        DateTime
  descripcion      String?
  paradaDespachoId String?
  paradaDespacho   Despacho? @relation(fields: [paradaDespachoId], references: [id])
}

// ---------- Vendedores ----------

// Rutas de venta (las del sistema de ventas: R1..R8, 10, 11, 12, 77) de un
// usuario VENDEDOR. Sus clientes son los VentaCliente de esas rutas, y de ahi
// salen los despachos que puede ver y los clientes que tiene que visitar.
model VendedorRuta {
  id        String  @id @default(cuid())
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa   Empresa
  ruta      String

  @@unique([usuarioId, empresa, ruta])
  @@index([empresa, ruta])
}

// Una visita del vendedor a un cliente. El estatus de la semana sale de
// aca: sin visita -> por visitar; con llegada y sin salida -> en el
// cliente; con salida -> atendido. Cada semana (ISO, hora de Caracas)
// empieza de cero sin borrar nada: basta con filtrar por `semana`.
model Visita {
  id                String    @id @default(cuid())
  vendedorId        String
  vendedor          Usuario   @relation(fields: [vendedorId], references: [id])
  empresa           Empresa
  codigoCliente     String // codigo del sistema de ventas (VentaCliente.codigo)
  semana            DateTime  @db.Date // lunes de la semana ISO de la llegada
  // La unica toma de GPS de la visita: al empezar la encuesta.
  llegadaEn         DateTime
  llegadaLat        Float?
  llegadaLng        Float?
  llegadaPrecisionM Float?
  // Distancia entre ese punto y el cliente (si esta en el maestro de
  // logistica con coordenadas): lo que dice si de verdad fue.
  distanciaClienteM Float?
  salidaEn          DateTime?
  observaciones     String?

  @@index([vendedorId, semana])
  @@index([empresa, codigoCliente])
}

// ---------- Indicadores de venta ----------
//
// Modulo aparte de la operacion logistica: el extracto de ventas de cada
// empresa se sube por carga (mensual o diaria) y de ahi salen los
// indicadores (ver backend/app/services/indicadores_venta.py). Todo va por
// empresa: ISVAN y TRALOG tienen carteras y catalogos distintos.

// Un archivo subido. Se analiza primero (PENDIENTE, sus filas ya quedan en
// Venta pero no cuentan) y el ADMIN lo confirma despues de ver la
// validacion. Revertirla la saca de los indicadores sin perder el registro.
model VentaCarga {
  id           String           @id @default(cuid())
  empresa      Empresa
  archivo      String
  periodoDesde DateTime         @db.Date
  periodoHasta DateTime         @db.Date
  filas        Int
  estado       EstadoCargaVenta @default(PENDIENTE)
  subidaEn     DateTime         @default(now())
  subidaPorId  String
  subidaPor    Usuario          @relation(fields: [subidaPorId], references: [id])
  confirmadaEn DateTime?
  revertidaEn  DateTime?
  // La validacion que se le mostro al ADMIN antes de confirmar, para poder
  // revisarla despues desde el historial.
  resumen      Json
  // Clientes y productos tal como vienen en el archivo. Se aplican a
  // VentaCliente/VentaProducto recien al confirmar: una carga pendiente no
  // debe tocar los datos que ya se usan.
  dimensiones  Json

  ventas Venta[] @relation("VentasDeLaCarga")

  @@index([empresa, estado])
}

// Cliente segun el sistema de ventas (dim_cliente). No es el Cliente de
// logistica: el extracto trae clientes que no estan en el maestro de
// despacho; el cruce entre ambos es por (empresa, codigo).
model VentaCliente {
  id          String  @id @default(cuid())
  empresa     Empresa
  codigo      String
  nombre      String
  tipo        String // TRADICIONAL | MODERNO | DISTRIBUIDORES
  // Texto, no numero: conviven los formatos "R1".."R8" y "10", "11", "77".
  ruta        String
  listaPrecio String?

  @@unique([empresa, codigo])
  @@index([empresa, ruta])
}

// Producto segun el sistema de ventas (dim_producto). El costo es por CAJA
// (columna "Pc" de la hoja "precio de compras"), nunca por unidad.
model VentaProducto {
  id              String   @id @default(cuid())
  empresa         Empresa
  codigo          BigInt
  nombre          String
  grupo           String
  codigoProveedor String?
  unidadesPorCaja Int?
  litrosPorUnidad Decimal? @db.Decimal(12, 4)
  costoCajaUsd    Decimal? @db.Decimal(14, 4)

  @@unique([empresa, codigo])
  @@index([empresa, grupo])
}

// Una fila del extracto: un producto dentro de un documento.
model Venta {
  id                    BigInt              @id @default(autoincrement())
  empresa               Empresa
  cargaId               String
  carga                 VentaCarga          @relation("VentasDeLaCarga", fields: [cargaId], references: [id], onDelete: Cascade)
  // Si una carga posterior cubre la misma fecha, esta fila deja de contar
  // (el archivo nuevo manda en su periodo). Revertir esa carga la restaura.
  reemplazadaPorCargaId String?
  fecha                 DateTime            @db.Date
  numDoc                String
  codTipoDoc            String
  tipoMovimiento        TipoMovimientoVenta
  codigoCliente         String
  codigoProducto        BigInt
  // Decimales de sobra a proposito: ~5% de las filas trae cajas
  // fraccionarias (12 unidades de una caja de 36 = 0.3333333333) y el costo
  // es cajas x costo por caja; con 4 decimales los totales ya no cuadran al
  // centavo con los del sistema de ventas.
  cajas                 Decimal             @db.Decimal(20, 10)
  unidades              Int
  litros                Decimal             @db.Decimal(18, 6)
  montoBs               Decimal             @db.Decimal(20, 4)
  montoUsd              Decimal             @db.Decimal(20, 10)

  @@index([empresa, fecha])
  @@index([empresa, codigoCliente])
  @@index([empresa, codigoProducto])
  @@index([cargaId])
  @@index([reemplazadaPorCargaId])
}
