// Prisma es la fuente de verdad del esquema/migraciones. El backend Python
// (ver backend/app/core/db.py) accede a Postgres directo con psycopg + SQL
// plano contra las tablas que este schema crea via "prisma migrate" — no usa
// prisma-client-py (su motor bundleado todavia exige "url" dentro de
// datasource, que Prisma 7 ya no permite aca; la conexion real se configura
// en prisma.config.ts via DATABASE_URL). El generator "prisma-client-js" de
// abajo solo produce tipos de TypeScript para el frontend.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ---------- Enums ----------

enum RolUsuario {
  ADMIN
  DESPACHOS
  APROBADOR
  REPARTIDOR
  VENDEDOR // ve los despachos de sus rutas de venta y registra sus visitas
  COBRANZAS // verifica los pagos que reportan los clientes y ve su cartera
  SUPERVISOR // supervisa a los vendedores: ve sus visitas y el censo, sin tocar nada
}

enum Empresa {
  ISVAN
  TRALOG
}

enum AccionRevision {
  APROBADA
  RECHAZADA
}

enum EstadoDespacho {
  BORRADOR
  PENDIENTE_APROBACION
  APROBADO
  RECHAZADO
  EN_PREPARACION
  EN_TRANSITO
  ENTREGADO
  CANCELADO
}

enum EstadoRuta {
  PLANIFICADA
  EN_TRANSITO
  COMPLETADA
  CANCELADA
}

// Quien saco el despacho de su ruta (ver DespachoReverso).
enum AlcanceReverso {
  RUTA // el coordinador reverso la ruta entera
  DESPACHO // el coordinador saco ese despacho de la ruta
  REPARTIDOR // el repartidor marco la parada como "No se pudo entregar"
}

enum TipoVehiculo {
  CAMION_REFRIGERADO
  CAMIONETA
  MOTO
}

enum EstadoVehiculo {
  FUNCIONAL
  EN_MANTENIMIENTO
  FUERA_DE_SERVICIO
}

enum EstadoCargaVenta {
  PENDIENTE // analizada, esperando que el ADMIN la confirme
  CONFIRMADA // cuenta en los indicadores
  REVERTIDA // deshecha; queda solo como registro
}

enum EstadoCuentaPortal {
  PENDIENTE_CORREO // registrada, falta confirmar el correo con el codigo
  POR_VALIDAR // correo confirmado, cobranzas todavia no la vinculo a un cliente
  ACTIVA
  SUSPENDIDA
}

enum MetodoPago {
  PAGO_MOVIL
  TRANSFERENCIA
  // Los que siguen solo los registra cobranzas (pagos por fuera del portal).
  EFECTIVO
  DIVISAS
  RETENCION
  AJUSTE
}

enum EstadoPago {
  REPORTADO // lo envio el cliente; no descuenta hasta que se verifique
  VERIFICADO
  RECHAZADO
}

enum OrigenDocumento {
  EXTRACTO_VENTAS
  CXC // futuro: reporte de cuentas por cobrar del sistema administrativo
  MANUAL
  SISTEMA // emitido por el sistema administrativo
}

enum TipoMovimientoVenta {
  VENTA // FA (factura) y NE (nota de entrega)
  DEVOLUCION // DV y DN, con montos negativos
}

// ---------- Usuarios / autenticacion ----------

model Usuario {
  id             String     @id @default(cuid())
  // Dueno de la fila (ver Organizacion). Sin llave foranea a proposito: con
  // una sola organizacion el valor por defecto alcanza y ninguna escritura
  // existente cambia; el aislamiento entre organizaciones va con RLS.
  organizacionId String     @default("org-principal")
  nombre         String
  // Opcional solo para los motorizados autogestionados, que entran con
  // placa + PIN (ver backend/app/services/motorizados.py). Los demas
  // usuarios se crean siempre con correo.
  email          String?    @unique
  passwordHash   String
  rol            RolUsuario
  avatarUrl      String?
  activo         Boolean    @default(true)
  createdAt      DateTime   @default(now())

  // Motorizados que se registran solos (alta rotacion, moto propia): entran
  // con la placa de su moto y un PIN de 6 digitos. El telefono es para
  // contactarlos y pagarles el delivery (11 digitos, ej. 04141234567).
  autogestionado   Boolean   @default(false)
  telefono         String?
  pinHash          String?
  // Freno contra adivinar el PIN: tras varios intentos fallidos la cuenta
  // queda bloqueada un rato (ver motorizados.py).
  intentosFallidos Int       @default(0)
  bloqueadoHasta   DateTime?

  // Puede aprobar el despacho de un cliente con deuda vencida (ver
  // ExcepcionDespacho). El ADMIN siempre puede.
  autorizaExcepciones Boolean @default(false)

  // Solo tiene sentido para el rol REPARTIDOR: el vehiculo que maneja. Es
  // lo que acota lo que ese usuario puede ver — su vehiculo lleva una sola
  // ruta activa a la vez, y esa es la unica ruta a la que tiene acceso (ver
  // backend/app/core/permisos.py). Nullable porque los demas roles no lo
  // usan, y porque un repartidor puede quedar sin vehiculo asignado.
  vehiculoAsignadoId String?
  vehiculoAsignado   Vehiculo? @relation("ConductorDelVehiculo", fields: [vehiculoAsignadoId], references: [id])

  despachosCreados      Despacho[]               @relation("DespachosCreadosPor")
  aprobacionesDespacho  DespachoAprobacion[]
  rutasCreadas          Ruta[]                   @relation("RutasCreadas")
  rutasCanceladas       Ruta[]                   @relation("RutasCanceladas")
  reversosDespacho      DespachoReverso[]        @relation("ReversosDespacho")
  sesiones              Sesion[]
  cargasVenta           VentaCarga[]
  listasPrecio          ListaPrecioCarga[]       @relation("ListasPrecioSubidasPor")
  tabuladorDelivery     TabuladorDelivery[]      @relation("TabuladorDeliveryActualizadoPor")
  liquidacionesDelivery LiquidacionDelivery[]    @relation("LiquidacionesDelivery")
  liquidacionesCreadas  LiquidacionDelivery[]    @relation("LiquidacionesDeliveryCreadasPor")
  liquidacionesAnuladas LiquidacionDelivery[]    @relation("LiquidacionesDeliveryAnuladasPor")
  paradasExcluidas      ParadaDeliveryExcluida[] @relation("ParadasDeliveryExcluidasPor")
  redesViales           RedVialCarga[]           @relation("RedVialCargadaPor")
  metasVenta            MetaVenta[]              @relation("MetasActualizadasPor")
  metasLitros           MetaLitros[]             @relation("MetasLitrosActualizadasPor")
  censos                Censo[]                  @relation("CensosLlenados")
  maestrasSubidas       MaestraCarga[]           @relation("MaestrasSubidasPor")
  censosCorregidos      Censo[]                  @relation("CensosCorregidos")
  censosDevueltos       Censo[]                  @relation("CensosDevueltos")
  configuraciones       Configuracion[]          @relation("ConfiguracionActualizadaPor")
  // Solo rol VENDEDOR: sus rutas de venta y las visitas que registra.
  rutasVenta            VendedorRuta[]
  visitas               Visita[]
  // Cobranzas
  clientesVinculados    CuentaPortalCliente[]    @relation("VinculadoPor")
  tasasRegistradas      TasaCambio[]             @relation("TasaRegistradaPor")
  pagosRegistrados      Pago[]                   @relation("PagoRegistradoPor")
  pagosRevisados        Pago[]                   @relation("PagoRevisadoPor")
  excepcionesDespacho   ExcepcionDespacho[]
  empresas              UsuarioEmpresa[]
  permisosExtra         UsuarioPermiso[]
  cargasGasto           GastoCarga[]
  // App movil: las jornadas de campo y la ultima posicion conocida.
  jornadas              Jornada[]
  ultimaPosicion        UltimaPosicion?
  demandasNoAtendidas   DemandaNoAtendida[]      @relation("DemandaNoAtendidaVendedor")
}

// Sesiones respaldadas en BD (no JWT): revocar una sesion es borrar la fila,
// lo cual conviene para un equipo pequeno donde puede hacer falta cerrar la
// sesion de alguien a mano. El token crudo nunca se guarda, solo su hash.
model Sesion {
  id          String    @id @default(cuid())
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id])
  tokenHash   String    @unique
  creadoEn    DateTime  @default(now())
  expiraEn    DateTime
  // WEB (cookie) | MOVIL (token Bearer de la app de campo). La de la app
  // dura mas y se renueva sola con el uso (ver app/core/auth.py).
  origen      String    @default("WEB")
  dispositivo String?
  ultimoUsoEn DateTime?
}

// ---------- Almacen y flota ----------

model Almacen {
  id             String  @id @default(cuid())
  // Dueno de la fila (ver Organizacion). Sin llave foranea a proposito: con
  // una sola organizacion el valor por defecto alcanza y ninguna escritura
  // existente cambia; el aislamiento entre organizaciones va con RLS.
  organizacionId String  @default("org-principal")
  nombre         String
  tipo           String // "Centro de Distribucion" | "Planta" | "Tienda"
  direccion      String
  ciudad         String
  lat            Float
  lng            Float
  esFrigorifico  Boolean @default(true)

  despachosOrigen     Despacho[]           @relation("DespachoOrigen")
  vehiculos           Vehiculo[]
  rutas               Ruta[]
  distanciasCliente   DistanciaCliente[]
  demandasNoAtendidas DemandaNoAtendida[]
}

model Vehiculo {
  id                 String         @id @default(cuid())
  // Dueno de la fila (ver Organizacion). Sin llave foranea a proposito: con
  // una sola organizacion el valor por defecto alcanza y ninguna escritura
  // existente cambia; el aislamiento entre organizaciones va con RLS.
  organizacionId     String         @default("org-principal")
  placa              String         @unique
  tipo               TipoVehiculo
  capacidadKg        Float
  tieneRefrigeracion Boolean        @default(true)
  estado             EstadoVehiculo @default(FUNCIONAL)
  almacenBaseId      String
  almacenBase        Almacen        @relation(fields: [almacenBaseId], references: [id])
  conductorNombre    String?
  ultimaRevision     DateTime?
  // Costo operativo por kilometro (USD) usado para estimar el costo de una
  // ruta sugerida. Opcional: si no esta cargado se usa un valor de
  // referencia por tipo de vehiculo (ver plan_rutas.COSTO_POR_KM_POR_TIPO).
  costoPorKm         Float?

  rutas             Ruta[]
  rutasApoyo        Ruta[]                      @relation("RutaVehiculoApoyo")
  conductores       Usuario[]                   @relation("ConductorDelVehiculo")
  paradasLiquidadas LiquidacionDeliveryParada[]
  paradasExcluidas  ParadaDeliveryExcluida[]
}

// ---------- Clientes ----------

// El mismo codigo puede referirse a clientes distintos segun la empresa
// (ISVAN / TRALOG comparten almacen y flota pero no su cartera de clientes),
// asi que la llave de negocio es (empresa, codigo), no el codigo solo.
model Cliente {
  id             String  @id @default(cuid())
  // Dueno de la fila (ver Organizacion). Sin llave foranea a proposito: con
  // una sola organizacion el valor por defecto alcanza y ninguna escritura
  // existente cambia; el aislamiento entre organizaciones va con RLS.
  organizacionId String  @default("org-principal")
  empresa        Empresa
  codigo         String // ej. "CLI-0001", unico solo dentro de su empresa
  nombre         String
  tipo           String // "Tienda" | "Distribuidor" | "Consumidor final"
  direccion      String
  ciudad         String
  lat            Float?
  lng            Float?
  // Obligatorio: lo usan los despachadores para contactar al cliente.
  telefono       String
  email          String?
  // Ruta comercial (de venta/reparto) a la que el negocio asigna al cliente,
  // p.ej. "R-07". No es la Ruta (viaje) de este sistema: es un dato del
  // cliente que viene del extracto de ventas y se usa como criterio de peso
  // al sugerir como agrupar despachos en un viaje (ver
  // backend/app/services/plan_rutas.py). Opcional porque hay clientes
  // cargados antes de que existiera la columna.
  rutaComercial  String?

  despachos         Despacho[]                  @relation("DespachoDestino")
  distanciasAlmacen DistanciaCliente[]
  paradasLiquidadas LiquidacionDeliveryParada[]
  paradasExcluidas  ParadaDeliveryExcluida[]
  censos            CensoCliente[]

  // ---- Ficha fiscal y comercial (sistema administrativo, fase 0) ----
  // Opcionales: se completan desde el extracto, la maestra y el censo, y a
  // mano. Para facturar hacen falta rifCedula y razonSocial.
  rifCedula              String?
  razonSocial            String?
  domicilioFiscal        String?
  // Si es contribuyente especial, retiene el 75 o 100 % del IVA de cada
  // factura y entrega su comprobante (se registra como Pago RETENCION).
  contribuyenteEspecial  Boolean  @default(false)
  porcentajeRetencionIva Int?
  limiteCreditoUsd       Decimal? @db.Decimal(14, 2)
  diasCredito            Int?
  // Lo que hoy trae VentaCliente del extracto: ruta de venta, tipo y lista.
  rutaVenta              String?
  tipoVenta              String?
  listaPrecioCodigo      String?

  demandasNoAtendidas DemandaNoAtendida[]

  @@unique([empresa, codigo])
}

// ---------- Despachos ----------

model Despacho {
  id                   String         @id @default(cuid())
  // Dueno de la fila (ver Organizacion). Sin llave foranea a proposito: con
  // una sola organizacion el valor por defecto alcanza y ninguna escritura
  // existente cambia; el aislamiento entre organizaciones va con RLS.
  organizacionId       String         @default("org-principal")
  numero               String         @unique // ej. "D-0001"
  // Numero de factura/nota de entrega del documento origen (Excel o carga
  // manual). Junto con el tipo es la llave real de agrupacion e idempotencia
  // de la importacion: cada documento subido debe ser nuevo, nunca repetir
  // uno ya cargado.
  numeroDocumento      String
  // "FA" (factura) o "NE" (nota de entrega): el sistema de ventas repite el
  // mismo numero en los dos tipos, asi que sin el tipo no se sabe que papel
  // se entrega. Sale del extracto al importar; opcional porque hay despachos
  // anteriores y archivos que no traen la columna. Un numero sin tipo choca
  // con cualquier tipo de ese numero (lo revisa app/api/despachos.py): la
  // base no lo puede impedir porque trata los vacios como distintos.
  tipoDocumento        String?
  origenId             String
  origen               Almacen        @relation("DespachoOrigen", fields: [origenId], references: [id])
  destinoClienteId     String
  destinoCliente       Cliente        @relation("DespachoDestino", fields: [destinoClienteId], references: [id])
  creadoPorId          String
  creadoPor            Usuario        @relation("DespachosCreadosPor", fields: [creadoPorId], references: [id])
  estado               EstadoDespacho @default(BORRADOR)
  fechaCreacion        DateTime       @default(now())
  fechaEstimadaEntrega DateTime?

  // El vehiculo se asigna a nivel de Ruta (un vehiculo puede llevar varios
  // despachos en un mismo viaje), no por despacho suelto.
  rutaId      String?
  ruta        Ruta?   @relation(fields: [rutaId], references: [id])
  ordenEnRuta Int? // posicion de esta parada dentro de la ruta, calculada por el TSP

  // Marcas de tiempo que pone el repartidor en la calle, para medir su
  // rendimiento: cuando llego al cliente y cuando termino de entregar. La
  // diferencia entre ambas es el tiempo de atencion de esa parada; entre la
  // entrega anterior y esta llegada, el tiempo de traslado.
  llegadaEn   DateTime?
  entregadoEn DateTime?
  // Donde estaba el telefono al marcar (solo la app movil lo manda).
  llegadaLat   Float?
  llegadaLng   Float?
  entregadoLat Float?
  entregadoLng Float?

  items         DespachoItem[]
  aprobaciones  DespachoAprobacion[]
  puntosEntrega RutaPunto[] // puntos de la ruta marcados como la parada de este despacho
  // Si se aprobo aunque el cliente tenia deuda vencida.
  excepcion     ExcepcionDespacho?
  reversos      DespachoReverso[]

  @@unique([numeroDocumento, tipoDocumento])
}

model DespachoItem {
  id                 String   @id @default(cuid())
  despachoId         String
  despacho           Despacho @relation(fields: [despachoId], references: [id])
  // Texto libre (viene del Excel o de carga manual) — ya no hay catalogo de
  // productos: cada fila trae su propia descripcion, cantidad y peso.
  descripcion        String
  // Lo que el documento origen pedia originalmente (se copia y se congela al
  // crear el despacho). "cantidad" es lo que realmente se va a despachar: el
  // coordinador puede ajustarla a mano mientras el despacho no haya salido
  // del almacen.
  cantidadSolicitada Int
  cantidad           Int
  pesoUnitarioKg     Float
  requiereFrio       Boolean  @default(true)
}

// Auditoria de la aprobacion/rechazo del despacho.
model DespachoAprobacion {
  id         String         @id @default(cuid())
  despachoId String
  despacho   Despacho       @relation(fields: [despachoId], references: [id])
  usuarioId  String
  usuario    Usuario        @relation(fields: [usuarioId], references: [id])
  accion     AccionRevision
  comentario String?
  fecha      DateTime       @default(now())
}

// Un despacho que salio de su ruta sin entregarse y volvio a "Aprobado" (ver
// liberar_despachos en backend/app/api/rutas.py). Una fila por despacho y por
// vez: es el historial del despacho y la estadistica de cuantas paradas no
// entrego cada repartidor.
model DespachoReverso {
  id             String         @id @default(cuid())
  despachoId     String
  despacho       Despacho       @relation(fields: [despachoId], references: [id])
  rutaId         String
  ruta           Ruta           @relation(fields: [rutaId], references: [id])
  usuarioId      String
  usuario        Usuario        @relation("ReversosDespacho", fields: [usuarioId], references: [id])
  alcance        AlcanceReverso
  motivo         String
  estadoAnterior EstadoDespacho
  // La marca de llegada que tenia (el repartidor llego pero no pudo
  // entregar): al liberarlo se borra del despacho y queda aca.
  llegadaEn      DateTime?
  fecha          DateTime       @default(now())
  // El lugar que tenia en la ruta, para mostrarla en su sitio (en rojo) en la
  // linea de tiempo. Vacio en los reversos de antes de 2026-11-12.
  ordenEnRuta    Int?

  @@index([despachoId])
  @@index([rutaId])
  @@index([fecha])
}

// ---------- Rutas (multi-parada) ----------

// Un viaje de un vehiculo que agrupa varios despachos (uno por cliente),
// visitados en el orden que calcula el optimizador (TSP) a partir de
// Almacen Catia. Reemplaza el calculo "1 despacho = 1 tramo" de antes.
model Ruta {
  id               String     @id @default(cuid())
  // Dueno de la fila (ver Organizacion). Sin llave foranea a proposito: con
  // una sola organizacion el valor por defecto alcanza y ninguna escritura
  // existente cambia; el aislamiento entre organizaciones va con RLS.
  organizacionId   String     @default("org-principal")
  numero           String     @unique // ej. "R-0001"
  // Opcional: una ruta se puede planificar antes de tener vehiculo (que no
  // frene la planificacion si la flota esta ocupada) y asignarselo despues.
  // Sin vehiculo no la ve ningun repartidor ni se puede iniciar.
  vehiculoId       String?
  vehiculo         Vehiculo?  @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)
  // Morocho: un pedido grande que sale en dos motos. La segunda moto (la
  // principal es vehiculoId); con ella la ruta es un Morocho. Su repartidor
  // tambien ve la ruta y cobra cada parada (ver app/services/plan_rutas.py).
  vehiculoApoyoId  String?
  vehiculoApoyo    Vehiculo?  @relation("RutaVehiculoApoyo", fields: [vehiculoApoyoId], references: [id], onDelete: Restrict)
  origenId         String
  origen           Almacen    @relation(fields: [origenId], references: [id])
  creadoPorId      String
  creadoPor        Usuario    @relation("RutasCreadas", fields: [creadoPorId], references: [id])
  estado           EstadoRuta @default(PLANIFICADA)
  fechaCreacion    DateTime   @default(now())
  // Cuando tiene que salir del almacen: la fecha y hora de recogida de todos
  // sus pedidos. Un vehiculo puede tener varias rutas planificadas en
  // horarios distintos (ver app/services/planificacion.py).
  salidaProgramada DateTime
  // Cuando el vehiculo salio del almacen y cuando se entrego la ultima
  // parada. Con estas dos y las marcas de cada Despacho se arma el reporte
  // de rendimiento del viaje (duracion real vs estimada, tiempo hasta la
  // primera parada, tiempo entre paradas).
  iniciadaEn       DateTime?
  completadaEn     DateTime?
  distanciaTotalKm Float?
  tiempoTotalMin   Int?

  // Reverso (ver POST /rutas/{id}/reversar): la ruta queda CANCELADA y sus
  // despachos sin entregar vuelven a "Aprobado" sin ruta; los entregados se
  // quedan. Como al liberarlos se pierde Despacho.rutaId, los numeros de los
  // liberados se guardan aca para que el historial siga diciendo que tenia.
  canceladaEn         DateTime?
  canceladaPorId      String?
  canceladaPor        Usuario?  @relation("RutasCanceladas", fields: [canceladaPorId], references: [id])
  motivoCancelacion   String?
  despachosAlCancelar Json?

  despachos         Despacho[]
  puntos            RutaPunto[]
  paradasLiquidadas LiquidacionDeliveryParada[]
  paradasExcluidas  ParadaDeliveryExcluida[]
  reversos          DespachoReverso[]

  @@index([salidaProgramada])
  @@index([vehiculoId, estado])
  @@index([vehiculoApoyoId, estado])
}

// Waypoints de la geometria de una Ruta multi-parada, usados tanto para
// dibujar el trazado calculado como para el seguimiento en vivo.
// paradaDespachoId marca los puntos que corresponden a la llegada/entrega en
// un cliente especifico (a diferencia de los puntos intermedios del trazado).
model RutaPunto {
  id               String    @id @default(cuid())
  rutaId           String
  ruta             Ruta      @relation(fields: [rutaId], references: [id])
  orden            Int
  lat              Float
  lng              Float
  estado           String // "salida" | "en_ruta" | "parada" | "entregado"
  timestamp        DateTime
  descripcion      String?
  paradaDespachoId String?
  paradaDespacho   Despacho? @relation(fields: [paradaDespachoId], references: [id])
}

// ---------- Vendedores ----------

// Rutas de venta (las del sistema de ventas: R1..R8, 10, 11, 12, 77) de un
// usuario VENDEDOR. Sus clientes son los VentaCliente de esas rutas, y de ahi
// salen los despachos que puede ver y los clientes que tiene que visitar.
model VendedorRuta {
  id             String  @id @default(cuid())
  // Dueno de la fila (ver Organizacion). Sin llave foranea a proposito: con
  // una sola organizacion el valor por defecto alcanza y ninguna escritura
  // existente cambia; el aislamiento entre organizaciones va con RLS.
  organizacionId String  @default("org-principal")
  usuarioId      String
  usuario        Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa        Empresa
  ruta           String

  @@unique([usuarioId, empresa, ruta])
  @@index([empresa, ruta])
}

// Una visita del vendedor a un cliente. El estatus de la semana sale de
// aca: sin visita -> por visitar; con llegada y sin salida -> en el
// cliente; con salida -> atendido. Cada semana (ISO, hora de Caracas)
// empieza de cero sin borrar nada: basta con filtrar por `semana`.
model Visita {
  id                String    @id @default(cuid())
  // Dueno de la fila (ver Organizacion). Sin llave foranea a proposito: con
  // una sola organizacion el valor por defecto alcanza y ninguna escritura
  // existente cambia; el aislamiento entre organizaciones va con RLS.
  organizacionId    String    @default("org-principal")
  vendedorId        String
  vendedor          Usuario   @relation(fields: [vendedorId], references: [id])
  empresa           Empresa
  codigoCliente     String // codigo del sistema de ventas (VentaCliente.codigo)
  semana            DateTime  @db.Date // lunes de la semana ISO de la llegada
  // La unica toma de GPS de la visita: al empezar la encuesta.
  llegadaEn         DateTime
  llegadaLat        Float?
  llegadaLng        Float?
  llegadaPrecisionM Float?
  // Distancia entre ese punto y el cliente (si esta en el maestro de
  // logistica con coordenadas): lo que dice si de verdad fue.
  distanciaClienteM Float?
  salidaEn          DateTime?
  observaciones     String?

  @@index([vendedorId, semana])
  @@index([empresa, codigoCliente])
}

// ---------- Indicadores de venta ----------
//
// Modulo aparte de la operacion logistica: el extracto de ventas de cada
// empresa se sube por carga (mensual o diaria) y de ahi salen los
// indicadores (ver backend/app/services/indicadores_venta.py). Todo va por
// empresa: ISVAN y TRALOG tienen carteras y catalogos distintos.

// Un archivo subido. Se analiza primero (PENDIENTE, sus filas ya quedan en
// Venta pero no cuentan) y el ADMIN lo confirma despues de ver la
// validacion. Revertirla la saca de los indicadores sin perder el registro.
model VentaCarga {
  id             String           @id @default(cuid())
  // Dueno de la fila (ver Organizacion). Sin llave foranea a proposito: con
  // una sola organizacion el valor por defecto alcanza y ninguna escritura
  // existente cambia; el aislamiento entre organizaciones va con RLS.
  organizacionId String           @default("org-principal")
  empresa        Empresa
  archivo        String
  periodoDesde   DateTime         @db.Date
  periodoHasta   DateTime         @db.Date
  filas          Int
  estado         EstadoCargaVenta @default(PENDIENTE)
  subidaEn       DateTime         @default(now())
  subidaPorId    String
  subidaPor      Usuario          @relation(fields: [subidaPorId], references: [id])
  confirmadaEn   DateTime?
  revertidaEn    DateTime?
  // La validacion que se le mostro al ADMIN antes de confirmar, para poder
  // revisarla despues desde el historial.
  // EXTRACTO: subida por el administrador. SISTEMA: la carga permanente donde
  // escribe el sistema administrativo al emitir (una por empresa).
  origen         String           @default("EXTRACTO")
  resumen        Json
  // Clientes y productos tal como vienen en el archivo. Se aplican a
  // VentaCliente/VentaProducto recien al confirmar: una carga pendiente no
  // debe tocar los datos que ya se usan.
  dimensiones    Json

  ventas Venta[] @relation("VentasDeLaCarga")

  @@index([empresa, estado])
}

// Cliente segun el sistema de ventas (dim_cliente). No es el Cliente de
// logistica: el extracto trae clientes que no estan en el maestro de
// despacho; el cruce entre ambos es por (empresa, codigo).
model VentaCliente {
  id             String  @id @default(cuid())
  // Dueno de la fila (ver Organizacion). Sin llave foranea a proposito: con
  // una sola organizacion el valor por defecto alcanza y ninguna escritura
  // existente cambia; el aislamiento entre organizaciones va con RLS.
  organizacionId String  @default("org-principal")
  empresa        Empresa
  codigo         String
  nombre         String
  tipo           String // TRADICIONAL | MODERNO | DISTRIBUIDORES
  // Texto, no numero: conviven los formatos "R1".."R8" y "10", "11", "77".
  ruta           String
  listaPrecio    String?

  @@unique([empresa, codigo])
  @@index([empresa, ruta])
}

// Producto segun el sistema de ventas (dim_producto). El costo es por CAJA
// (columna "Pc" de la hoja "precio de compras"), nunca por unidad.
model VentaProducto {
  id              String   @id @default(cuid())
  // Dueno de la fila (ver Organizacion). Sin llave foranea a proposito: con
  // una sola organizacion el valor por defecto alcanza y ninguna escritura
  // existente cambia; el aislamiento entre organizaciones va con RLS.
  organizacionId  String   @default("org-principal")
  empresa         Empresa
  codigo          BigInt
  nombre          String
  grupo           String
  codigoProveedor String?
  unidadesPorCaja Int?
  litrosPorUnidad Decimal? @db.Decimal(12, 4)
  costoCajaUsd    Decimal? @db.Decimal(14, 4)

  @@unique([empresa, codigo])
  @@index([empresa, grupo])
}

// Lista de precios de compra (costo por caja) subida sola, sin un extracto
// de ventas. Se aplica a VentaProducto al subirla y se guarda entera para
// volver a aplicarla, en orden con las cargas, cuando se revierte una carga
// de ventas (ver revertir_carga en backend/app/api/indicadores.py).
model ListaPrecioCarga {
  id             String   @id @default(cuid())
  // Dueno de la fila (ver Organizacion). Sin llave foranea a proposito: con
  // una sola organizacion el valor por defecto alcanza y ninguna escritura
  // existente cambia; el aislamiento entre organizaciones va con RLS.
  organizacionId String   @default("org-principal")
  empresa        Empresa
  archivo        String
  // [{codigo, nombre, grupo, costoCajaUsd}]
  productos      Json
  subidaEn       DateTime @default(now())
  subidaPorId    String?
  subidaPor      Usuario? @relation("ListasPrecioSubidasPor", fields: [subidaPorId], references: [id], onDelete: SetNull)

  @@index([empresa, subidaEn])
}

// Meta de venta de una ruta para un mes, en dolares. La carga el cliente
// (no se calcula): con tres meses de historia y creciendo, un pronostico
// estadistico diria mas de la recta que del negocio.
//
// Por ruta y no por empresa para que el grafico siga valiendo al filtrar:
// la meta de la empresa es la suma de sus rutas. Las ventas no traen
// vendedor, solo cliente y ruta (ver VentaCliente.ruta), asi que la ruta es
// el nivel mas fino que el dato soporta.
model MetaVenta {
  id             String   @id @default(cuid())
  // Dueno de la fila (ver Organizacion). Sin llave foranea a proposito: con
  // una sola organizacion el valor por defecto alcanza y ninguna escritura
  // existente cambia; el aislamiento entre organizaciones va con RLS.
  organizacionId String   @default("org-principal")
  empresa        Empresa
  ruta           String
  // Primer dia del mes, como el resto de los periodos del modulo.
  mes            DateTime @db.Date
  montoUsd       Decimal  @db.Decimal(20, 2)

  actualizadoEn    DateTime @default(now()) @updatedAt
  actualizadoPorId String?
  actualizadoPor   Usuario? @relation("MetasActualizadasPor", fields: [actualizadoPorId], references: [id], onDelete: SetNull)

  @@unique([empresa, ruta, mes])
  @@index([empresa, mes])
}

// Meta de litros vendidos por ruta y mes, para el cuadro de metas (ver
// app/services/cuadro_metas.py). Aparte de MetaVenta (USD): el cliente
// maneja las dos y no siempre las carga juntas.
model MetaLitros {
  id             String   @id @default(cuid())
  // Dueno de la fila (ver Organizacion). Sin llave foranea a proposito: con
  // una sola organizacion el valor por defecto alcanza y ninguna escritura
  // existente cambia; el aislamiento entre organizaciones va con RLS.
  organizacionId String   @default("org-principal")
  empresa        Empresa
  ruta           String
  // Primer dia del mes, como MetaVenta.
  mes            DateTime @db.Date
  litros         Decimal  @db.Decimal(14, 2)

  actualizadoEn    DateTime @default(now()) @updatedAt
  actualizadoPorId String?
  actualizadoPor   Usuario? @relation("MetasLitrosActualizadasPor", fields: [actualizadoPorId], references: [id], onDelete: SetNull)

  @@unique([empresa, ruta, mes])
  @@index([empresa, mes])
}

// Feriados nacionales: no cuentan como dias de venta en el cuadro de metas
// (dias de venta = lunes a viernes menos feriados). Los de Carnaval y Semana
// Santa cambian cada ano: se cargan a mano.
model DiaFeriado {
  fecha  DateTime @id @db.Date
  nombre String
}

// Una fila del extracto: un producto dentro de un documento.
model Venta {
  id                    BigInt              @id @default(autoincrement())
  // Dueno de la fila (ver Organizacion). Sin llave foranea a proposito: con
  // una sola organizacion el valor por defecto alcanza y ninguna escritura
  // existente cambia; el aislamiento entre organizaciones va con RLS.
  organizacionId        String              @default("org-principal")
  empresa               Empresa
  cargaId               String
  carga                 VentaCarga          @relation("VentasDeLaCarga", fields: [cargaId], references: [id], onDelete: Cascade)
  // Si una carga posterior cubre la misma fecha, esta fila deja de contar
  // (el archivo nuevo manda en su periodo). Revertir esa carga la restaura.
  reemplazadaPorCargaId String?
  fecha                 DateTime            @db.Date
  numDoc                String
  codTipoDoc            String
  tipoMovimiento        TipoMovimientoVenta
  codigoCliente         String
  codigoProducto        BigInt
  // Decimales de sobra a proposito: ~5% de las filas trae cajas
  // fraccionarias (12 unidades de una caja de 36 = 0.3333333333) y el costo
  // es cajas x costo por caja; con 4 decimales los totales ya no cuadran al
  // centavo con los del sistema de ventas.
  cajas                 Decimal             @db.Decimal(20, 10)
  unidades              Int
  litros                Decimal             @db.Decimal(18, 6)
  montoBs               Decimal             @db.Decimal(20, 4)
  montoUsd              Decimal             @db.Decimal(20, 10)
  // Costo por caja sellado al confirmar la carga: el que regia en ese
  // periodo. Una lista de precios nueva NO toca los meses ya cerrados.
  // NULL en las ventas anteriores al backfill; las consultas caen al costo
  // vigente del producto con COALESCE (ver SUMAS en indicadores_venta.py).
  costoCajaUsd          Decimal?            @db.Decimal(14, 4)

  @@index([empresa, fecha])
  @@index([empresa, codigoCliente])
  @@index([empresa, codigoProducto])
  @@index([cargaId])
  @@index([reemplazadaPorCargaId])
}

// ---------- Delivery (pago a motorizados) ----------
//
// A los motorizados se les paga por entrega segun la distancia del almacen
// al cliente, con un tabulador por rangos. El modulo solo mira las rutas de
// vehiculos MOTO y las paradas con marca de entrega; ver
// backend/app/services/delivery.py.

// Un rango del tabulador: "hasta hastaKm se pagan montoUsd". El ultimo va
// sin tope (hastaKm = null) y atrapa todo lo que quede por encima.
model TabuladorDelivery {
  id               String   @id @default(cuid())
  // Dueno de la fila (ver Organizacion). Sin llave foranea a proposito: con
  // una sola organizacion el valor por defecto alcanza y ninguna escritura
  // existente cambia; el aislamiento entre organizaciones va con RLS.
  organizacionId   String   @default("org-principal")
  orden            Int      @unique
  hastaKm          Float?
  montoUsd         Decimal  @db.Decimal(10, 2)
  actualizadoEn    DateTime @default(now())
  actualizadoPorId String?
  actualizadoPor   Usuario? @relation("TabuladorDeliveryActualizadoPor", fields: [actualizadoPorId], references: [id])
}

// Distancia del almacen al cliente (ida, por vialidad). Se calcula una vez
// y se guarda: el pago no depende del orden del viaje ni de que el servicio
// de rutas responda en el momento del reporte.
model DistanciaCliente {
  id          String   @id @default(cuid())
  almacenId   String
  almacen     Almacen  @relation(fields: [almacenId], references: [id])
  clienteId   String
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  km          Float
  // "iserver" (red vial real) o "estimada" (linea recta por un factor).
  fuente      String
  calculadoEn DateTime @default(now())

  @@unique([almacenId, clienteId])
}

// Un pago cerrado a un motorizado por un periodo. Congela lo que se le pago:
// cambiar el tabulador despues no altera una liquidacion hecha.
model LiquidacionDelivery {
  id              String    @id @default(cuid())
  // Dueno de la fila (ver Organizacion). Sin llave foranea a proposito: con
  // una sola organizacion el valor por defecto alcanza y ninguna escritura
  // existente cambia; el aislamiento entre organizaciones va con RLS.
  organizacionId  String    @default("org-principal")
  repartidorId    String
  repartidor      Usuario   @relation("LiquidacionesDelivery", fields: [repartidorId], references: [id])
  desde           DateTime  @db.Date
  hasta           DateTime  @db.Date
  entregas        Int
  totalUsd        Decimal   @db.Decimal(12, 2)
  creadoEn        DateTime  @default(now())
  creadoPorId     String
  creadoPor       Usuario   @relation("LiquidacionesDeliveryCreadasPor", fields: [creadoPorId], references: [id])
  nota            String?
  // Anulado: el pago se dio por no hecho y sus entregas volvieron a quedar
  // pendientes. Se conserva con su motivo; el detalle de lo que pagaba queda
  // en paradasAnuladas, porque sus filas de LiquidacionDeliveryParada se
  // borran (si no, esas entregas no se podrian volver a pagar).
  anuladaEn       DateTime?
  anuladaPorId    String?
  anuladaPor      Usuario?  @relation("LiquidacionesDeliveryAnuladasPor", fields: [anuladaPorId], references: [id], onDelete: SetNull)
  motivoAnulacion String?
  paradasAnuladas Json?

  paradas LiquidacionDeliveryParada[]

  @@index([repartidorId, desde])
}

// Una entrega pagable que se decidio no pagar (p. ej. rutas viejas cerradas
// tarde desde la oficina). Misma llave que LiquidacionDeliveryParada. No
// suma a lo pendiente; borrar la fila la devuelve a pendiente.
model ParadaDeliveryExcluida {
  id          String   @id @default(cuid())
  rutaId      String
  ruta        Ruta     @relation(fields: [rutaId], references: [id], onDelete: Cascade)
  clienteId   String
  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  vehiculoId  String
  vehiculo    Vehiculo @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)
  motivo      String
  creadoEn    DateTime @default(now())
  creadoPorId String?
  creadoPor   Usuario? @relation("ParadasDeliveryExcluidasPor", fields: [creadoPorId], references: [id], onDelete: SetNull)

  @@unique([rutaId, clienteId, vehiculoId])
}

// Cada parada pagada en una liquidacion. El unique (ruta, cliente) es lo que
// impide pagar dos veces la misma entrega.
model LiquidacionDeliveryParada {
  id            String              @id @default(cuid())
  liquidacionId String
  liquidacion   LiquidacionDelivery @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  rutaId        String
  ruta          Ruta                @relation(fields: [rutaId], references: [id])
  clienteId     String
  cliente       Cliente             @relation(fields: [clienteId], references: [id])
  entregadoEn   DateTime
  km            Float
  montoUsd      Decimal             @db.Decimal(10, 2)
  // El rango del tabulador con el que se pago, tal como se mostro.
  rango         String
  // A que moto se le pago: en un Morocho cada una cobra la parada.
  vehiculoId    String?
  vehiculo      Vehiculo?           @relation(fields: [vehiculoId], references: [id], onDelete: SetNull)

  @@unique([rutaId, clienteId, vehiculoId])
  @@index([liquidacionId])
}

// ---------- Red vial (calculo de rutas en la base) ----------
//
// La red vial de Venezuela (OpenStreetMap) vive en la base y pgRouting
// calcula sobre ella los trazados y las distancias, en vez del iServer de
// SuperMap. Ver backend/app/services/red_vial.py y el cargador
// backend/scripts/cargar_red_vial.py.
//
// Las columnas de geometria son de PostGIS, que Prisma no modela: van como
// Unsupported. El backend las consulta con SQL directo, asi que no hace
// falta mas.

// Un tramo de calle entre dos cruces. source/target son los nodos que
// conectan; costoMin es el tiempo en minutos que cuesta recorrerlo, y
// costoMinInverso vale -1 en los tramos de un solo sentido (asi es como
// pgRouting bloquea la direccion contraria).
model RedVialTramo {
  id              BigInt                                    @id @default(autoincrement())
  osmId           String?
  source          Int?
  target          Int?
  costoMin        Float
  costoMinInverso Float
  longitudM       Float
  velocidadKmh    Float
  /// Clase de via de OpenStreetMap: motorway, primary, residential...
  tipo            String
  nombre          String?
  /// "B" doble sentido, "F" solo en el sentido de la linea, "T" solo al reves.
  sentido         String
  geom            Unsupported("geometry(LineString, 4326)")

  @@index([source])
  @@index([target])
  @@index([geom], type: Gist)
}

// Los cruces de la red. Los calcula el cargador con pgr_extractVertices a
// partir de los extremos de cada tramo.
model RedVialNodo {
  id   BigInt                               @id
  geom Unsupported("geometry(Point, 4326)")

  @@index([geom], type: Gist)
}

// Que red esta montada: de que archivo salio y como quedo. Sirve para saber
// con que datos se estan calculando las rutas.
model RedVialCarga {
  id                 String   @id @default(cuid())
  archivo            String
  tramos             Int
  nodos              Int
  /// Tramos del archivo que no se cargaron (peatonales, escaleras, senderos).
  tramosDescartados  Int
  /// Tramos sin velocidad en el dato original: se les asigno una por tipo de via.
  tramosSinVelocidad Int
  /// Resumen del chequeo: extension cubierta, componentes conexos, avisos.
  resumen            Json
  cargadoEn          DateTime @default(now())
  cargadoPorId       String?
  cargadoPor         Usuario? @relation("RedVialCargadaPor", fields: [cargadoPorId], references: [id])
}

// Cache de rutas ya calculadas: la misma consulta no se vuelve a resolver
// contra la red. Las coordenadas se guardan redondeadas (ver
// DECIMALES_CACHE en backend/app/services/red_vial.py).
model RutaCalculada {
  id          String   @id @default(cuid())
  perfil      String   @default("vehiculo")
  origenLat   Float
  origenLng   Float
  destinoLat  Float
  destinoLng  Float
  distanciaKm Float
  tiempoMin   Int
  /// El trazado como [[lng, lat], ...], listo para dibujar.
  geometria   Json
  calculadoEn DateTime @default(now())

  @@unique([perfil, origenLat, origenLng, destinoLat, destinoLng])
}

// ---------- Censo de clientes (formularios desde XLSForm) ----------
//
// Un formulario lleno. La definicion (preguntas, listas, relevant,
// constraint...) vive en backend/app/formularios/<formulario>.json,
// importada del XLSForm de Survey123; aca se guarda con que version se lleno
// y las respuestas tal cual (solo las relevantes), mas unas columnas sacadas
// de ellas para listar y filtrar sin abrir el JSON.
model Censo {
  id               String      @id @default(cuid())
  // Dueno de la fila (ver Organizacion). Sin llave foranea a proposito: con
  // una sola organizacion el valor por defecto alcanza y ninguna escritura
  // existente cambia; el aislamiento entre organizaciones va con RLS.
  organizacionId   String      @default("org-principal")
  formulario       String
  version          String
  usuarioId        String
  usuario          Usuario     @relation("CensosLlenados", fields: [usuarioId], references: [id])
  respuestas       Json
  lat              Float?
  lng              Float?
  encuestador      String?
  nombreComercio   String?
  tipoCliente      String?
  empresa          String?
  ruta             String?
  // Del telefono: cuando se abrio el formulario y cuando se envio.
  iniciadoEn       DateTime
  terminadoEn      DateTime
  recibidoEn       DateTime    @default(now())
  // PAGINA: lleno aca. SURVEY123: importado del historico; externoId es su
  // id alla, para que reimportar el mismo archivo no duplique.
  origen           OrigenCenso @default(PAGINA)
  externoId        String?     @unique
  // Otro censo anterior del mismo cliente en el mismo lugar (ver
  // backend/app/services/censo_clientes.py): no cuenta en los indicadores y
  // queda listado para borrarlo.
  duplicadoDeId    String?
  duplicadoDe      Censo?      @relation("CensoDuplicado", fields: [duplicadoDeId], references: [id], onDelete: SetNull)
  duplicados       Censo[]     @relation("CensoDuplicado")
  // Descartado por el ADMIN (un duplicado): sale de todo, pero la fila
  // queda para que reimportar el historico no lo traiga de vuelta.
  descartadoEn     DateTime?
  // Empresa o codigo corregidos desde Clientes (censos por corregir).
  corregidoEn      DateTime?
  corregidoPorId   String?
  corregidoPor     Usuario?    @relation("CensosCorregidos", fields: [corregidoPorId], references: [id], onDelete: SetNull)
  // Devuelto al vendedor desde Censos por corregir (sus errores no permiten
  // registrar el cliente): ademas queda descartado (descartadoEn), asi sale
  // de todo; el vendedor lo ve con el motivo para censarlo de nuevo.
  // loteDevolucion agrupa los devueltos de una vez, para deshacerlos juntos.
  devueltoEn       DateTime?
  devueltoPorId    String?
  devueltoPor      Usuario?    @relation("CensosDevueltos", fields: [devueltoPorId], references: [id], onDelete: SetNull)
  motivoDevolucion String?
  loteDevolucion   String?

  fotos    CensoFoto[]
  clientes CensoCliente[]

  @@index([formulario, recibidoEn])
  @@index([usuarioId, recibidoEn])
  @@index([duplicadoDeId])
  @@index([loteDevolucion])
}

enum OrigenCenso {
  PAGINA
  SURVEY123
}

// Que hizo el censo con cada cliente que nombra (uno por empresa; AMBAS son
// dos filas). Un posible cliente (nuevo que no desea comprar) no tiene filas.
enum AccionCensoCliente {
  CREADO // no existia en Clientes y se creo
  COMPLETADO // existia y se le llenaron campos vacios (coordenadas, ruta)
  EXISTENTE // existia completo: no se toco
  REVISAR // no se toco: el codigo parece equivocado (ver motivo)
}

model CensoCliente {
  id          String             @id @default(cuid())
  censoId     String
  censo       Censo              @relation(fields: [censoId], references: [id], onDelete: Cascade)
  empresa     Empresa
  // Sin ceros a la izquierda, como en ventas.
  codigo      String
  // Contra la maestra vigente y los clientes con ventas, al procesarlo.
  enMaestra   Boolean            @default(false)
  enVentas    Boolean            @default(false)
  clienteId   String?
  cliente     Cliente?           @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  accion      AccionCensoCliente
  motivo      String?
  procesadoEn DateTime           @default(now())

  @@unique([censoId, empresa])
  @@index([empresa, codigo])
}

// ---------- Maestra de clientes ----------
//
// El padron que el cliente mantiene aparte del sistema de ventas, por
// empresa. Cada carga es una foto completa: vale la ultima de cada empresa
// (ver backend/app/services/maestra_import.py).
model MaestraCarga {
  id             String   @id @default(cuid())
  // Dueno de la fila (ver Organizacion). Sin llave foranea a proposito: con
  // una sola organizacion el valor por defecto alcanza y ninguna escritura
  // existente cambia; el aislamiento entre organizaciones va con RLS.
  organizacionId String   @default("org-principal")
  empresa        Empresa
  archivo        String
  filas          Int
  resumen        Json
  subidaEn       DateTime @default(now())
  subidaPorId    String?
  subidaPor      Usuario? @relation("MaestrasSubidasPor", fields: [subidaPorId], references: [id], onDelete: SetNull)

  clientes MaestraCliente[]

  @@index([empresa, subidaEn])
}

model MaestraCliente {
  id             String       @id @default(cuid())
  // Dueno de la fila (ver Organizacion). Sin llave foranea a proposito: con
  // una sola organizacion el valor por defecto alcanza y ninguna escritura
  // existente cambia; el aislamiento entre organizaciones va con RLS.
  organizacionId String       @default("org-principal")
  cargaId        String
  carga          MaestraCarga @relation(fields: [cargaId], references: [id], onDelete: Cascade)
  empresa        Empresa
  // Sin ceros a la izquierda, como en ventas.
  codigo         String

  razonSocial  String
  // "5", "12"... ("77" son los dados de baja: fuera de "por censar").
  ruta         String?
  diaVisita    String?
  frecuencia   String?
  secuencia    String?
  direccion    String?
  condicion    String?
  tipoCliente  String?
  listaPrecio  String?
  zona         String?
  observacion  String?
  // El activo que trae el archivo: se guarda pero todavia no se usa.
  activoCodigo String?
  activoTipo   String?
  activoMarca  String?

  @@unique([cargaId, codigo])
  @@index([empresa, codigo])
  @@index([empresa, ruta])
}

// Las fotos van en el almacenamiento de archivos (ver
// backend/app/services/almacen_fotos.py), no en la base: aca solo la clave.
model CensoFoto {
  id       String   @id @default(cuid())
  censoId  String
  censo    Censo    @relation(fields: [censoId], references: [id], onDelete: Cascade)
  pregunta String
  clave    String
  tipo     String
  bytes    Int
  creadaEn DateTime @default(now())

  @@unique([censoId, pregunta])
}

// Ajustes de la operacion que el ADMIN cambia sin desplegar, como clave ->
// valor (ver app/services/configuracion.py). Sin fila, vale el valor por
// defecto del codigo.
model Configuracion {
  clave            String   @id
  valor            Json
  actualizadoEn    DateTime @default(now())
  actualizadoPorId String?
  actualizadoPor   Usuario? @relation("ConfiguracionActualizadaPor", fields: [actualizadoPorId], references: [id], onDelete: SetNull)
}

// ---------- Cobranzas ----------
//
// Cartera calculada aca: FA/NE del extracto de ventas son cargos; DV/DN y
// los pagos verificados, abonos. Las reglas de saldo, vencimiento y bloqueo
// viven en un solo lugar: backend/app/services/cartera.py.

// Cuenta de un cliente en el portal de autogestion. Separada de Usuario a
// proposito: tiene su propia sesion (SesionPortal, cookie portal_sesion) y
// nunca puede entrar a la API interna.
model CuentaPortal {
  id                 String             @id @default(cuid())
  // Dueno de la fila (ver Organizacion). Sin llave foranea a proposito: con
  // una sola organizacion el valor por defecto alcanza y ninguna escritura
  // existente cambia; el aislamiento entre organizaciones va con RLS.
  organizacionId     String             @default("org-principal")
  email              String             @unique
  passwordHash       String
  nombre             String
  rif                String
  telefono           String?
  estado             EstadoCuentaPortal @default(PENDIENTE_CORREO)
  correoVerificadoEn DateTime?
  // Lo que el cliente dijo ser al registrarse; cobranzas lo valida.
  empresaDeclarada   Empresa?
  codigoDeclarado    String?
  intentosFallidos   Int                @default(0)
  bloqueadoHasta     DateTime?
  createdAt          DateTime           @default(now())

  clientes CuentaPortalCliente[]
  sesiones SesionPortal[]
  codigos  CodigoCorreo[]
  pagos    Pago[]

  @@index([estado])
}

// Los clientes (empresa + codigo del sistema de ventas) que ve una cuenta:
// sucursales y las dos empresas.
model CuentaPortalCliente {
  id             String       @id @default(cuid())
  cuentaId       String
  cuenta         CuentaPortal @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  empresa        Empresa
  codigoCliente  String
  origen         String // AUTO_CORREO | COBRANZAS
  vinculadoPorId String?
  vinculadoPor   Usuario?     @relation("VinculadoPor", fields: [vinculadoPorId], references: [id], onDelete: SetNull)
  vinculadoEn    DateTime     @default(now())

  @@unique([cuentaId, empresa, codigoCliente])
  @@index([empresa, codigoCliente])
}

model SesionPortal {
  id        String       @id @default(cuid())
  cuentaId  String
  cuenta    CuentaPortal @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  tokenHash String       @unique
  creadoEn  DateTime     @default(now())
  expiraEn  DateTime
}

// Codigo de 6 digitos enviado por correo; solo se guarda su hash.
model CodigoCorreo {
  id         String       @id @default(cuid())
  cuentaId   String
  cuenta     CuentaPortal @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  proposito  String // CONFIRMAR | RECUPERAR
  codigoHash String
  enviadoEn  DateTime     @default(now())
  expiraEn   DateTime
  intentos   Int          @default(0)
  usadoEn    DateTime?

  @@index([cuentaId, proposito])
}

// Tasa oficial BCV (Bs por USD). La de una fecha es la de la fila mas
// reciente con fecha <= esa fecha.
model TasaCambio {
  fecha           DateTime @id @db.Date
  tasa            Decimal  @db.Decimal(20, 8)
  fuente          String // DOLARAPI | BCV_DIRECTO | MANUAL
  registradoEn    DateTime @default(now())
  registradoPorId String?
  registradoPor   Usuario? @relation("TasaRegistradaPor", fields: [registradoPorId], references: [id], onDelete: SetNull)
}

// Un documento por cobrar (FA/NE) o a favor del cliente (DV/DN, negativo).
model DocumentoCobro {
  id             String          @id @default(cuid())
  // Dueno de la fila (ver Organizacion). Sin llave foranea a proposito: con
  // una sola organizacion el valor por defecto alcanza y ninguna escritura
  // existente cambia; el aislamiento entre organizaciones va con RLS.
  organizacionId String          @default("org-principal")
  empresa        Empresa
  tipoDoc        String // FA | NE | DV | DN
  numero         String
  codigoCliente  String
  fecha          DateTime        @db.Date
  // Solo si el origen lo trae (CXC); si no, vence a fecha + dias de tolerancia.
  vencimiento    DateTime?       @db.Date
  montoUsd       Decimal         @db.Decimal(20, 2)
  montoBs        Decimal         @db.Decimal(20, 2)
  origen         OrigenDocumento
  // false si ya no esta en su origen (se revirtio la carga); se conserva
  // por los pagos que lo referencian.
  vigente        Boolean         @default(true)
  actualizadoEn  DateTime        @default(now())

  aplicaciones PagoAplicacion[]

  @@unique([empresa, tipoDoc, numero])
  @@index([empresa, codigoCliente])
  @@index([empresa, fecha])
}

model Pago {
  id                 String        @id @default(cuid())
  // Dueno de la fila (ver Organizacion). Sin llave foranea a proposito: con
  // una sola organizacion el valor por defecto alcanza y ninguna escritura
  // existente cambia; el aislamiento entre organizaciones va con RLS.
  organizacionId     String        @default("org-principal")
  numero             String        @unique // ej. "P-000123"
  empresa            Empresa
  codigoCliente      String
  // Quien lo cargo: el cliente desde el portal o cobranzas a mano.
  cuentaPortalId     String?
  cuentaPortal       CuentaPortal? @relation(fields: [cuentaPortalId], references: [id], onDelete: SetNull)
  registradoPorId    String?
  registradoPor      Usuario?      @relation("PagoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: SetNull)
  metodo             MetodoPago
  bancoCodigo        String?
  telefono           String?
  cedulaRif          String?
  cuenta             String?
  referencia         String?
  fechaPago          DateTime      @db.Date
  montoBs            Decimal?      @db.Decimal(20, 2)
  tasa               Decimal?      @db.Decimal(20, 8)
  montoUsd           Decimal       @db.Decimal(20, 2)
  comprobanteClave   String?
  comprobanteTipo    String?
  nota               String?
  estado             EstadoPago    @default(REPORTADO)
  reportadoEn        DateTime      @default(now())
  revisadoPorId      String?
  revisadoPor        Usuario?      @relation("PagoRevisadoPor", fields: [revisadoPorId], references: [id], onDelete: SetNull)
  revisadoEn         DateTime?
  motivoRechazo      String?
  // MANUAL hoy; BANCO cuando se concilie contra la API de los bancos.
  metodoVerificacion String?
  // Cuenta bancaria/caja de la empresa donde entro el pago (modulo Bancos).
  cuentaTesoreriaId  String?

  aplicaciones PagoAplicacion[]

  // Ademas, indice unico parcial (bancoCodigo, referencia, fechaPago) para
  // los pagos no rechazados: lo crea la migracion (Prisma no los modela).
  @@index([empresa, codigoCliente])
  @@index([estado, reportadoEn])
  @@index([cuentaPortalId])
}

model PagoAplicacion {
  id          String         @id @default(cuid())
  pagoId      String
  pago        Pago           @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  documentoId String
  documento   DocumentoCobro @relation(fields: [documentoId], references: [id], onDelete: Restrict)
  montoUsd    Decimal        @db.Decimal(20, 2)
  // true si nadie eligio el documento: el pago se repartio solo a lo que
  // vence primero al verificarlo (ver pagos.reparto_automatico).
  automatica  Boolean        @default(false)

  @@unique([pagoId, documentoId])
  @@index([documentoId])
}

// Despacho aprobado aunque el cliente tenia deuda vencida.
model ExcepcionDespacho {
  id              String   @id @default(cuid())
  despachoId      String   @unique
  despacho        Despacho @relation(fields: [despachoId], references: [id], onDelete: Cascade)
  autorizadoPorId String
  autorizadoPor   Usuario  @relation(fields: [autorizadoPorId], references: [id])
  motivo          String
  saldoVencidoUsd Decimal  @db.Decimal(20, 2)
  fecha           DateTime @default(now())
}

// Donde pagan los clientes (se muestra en el portal).
model CuentaBancariaEmpresa {
  id             String   @id @default(cuid())
  // Dueno de la fila (ver Organizacion). Sin llave foranea a proposito: con
  // una sola organizacion el valor por defecto alcanza y ninguna escritura
  // existente cambia; el aislamiento entre organizaciones va con RLS.
  organizacionId String   @default("org-principal")
  empresa        Empresa
  bancoCodigo    String
  tipo           String // PAGO_MOVIL | TRANSFERENCIA
  // Telefono (pago movil) o cuenta de 20 digitos (transferencia).
  numero         String
  rif            String
  titular        String
  activa         Boolean  @default(true)
  creadaEn       DateTime @default(now())

  @@index([empresa])
}

// ---------- Sistema administrativo: base multiempresa (fase 0) ----------
//
// Organizacion: el cliente que compra el sistema. EmpresaFiscal: cada RIF
// que factura dentro de ella. Hoy hay una organizacion ("org-principal") con
// ISVAN y TRALOG; su `codigo` es el mismo valor del enum Empresa, que las
// tablas existentes siguen usando hasta convertirlo tabla por tabla.

model Organizacion {
  id                  String              @id @default(cuid())
  nombre              String
  activa              Boolean             @default(true)
  creadaEn            DateTime            @default(now())
  empresas            EmpresaFiscal[]
  demandasNoAtendidas DemandaNoAtendida[]
}

model EmpresaFiscal {
  id                     String       @id @default(cuid())
  organizacionId         String
  organizacion           Organizacion @relation(fields: [organizacionId], references: [id])
  // El mismo valor del enum Empresa ("ISVAN", "TRALOG") para enlazar con
  // las tablas que todavia lo usan.
  codigo                 String
  rif                    String?
  razonSocial            String
  nombreComercial        String?
  domicilioFiscal        String?
  telefono               String?
  // La Providencia SNAT/2026/00093 lo pide en la factura.
  correo                 String?
  contribuyenteEspecial  Boolean      @default(false)
  // Agente de retencion de IVA: retiene 75 o 100 % del IVA a sus proveedores.
  agenteRetencionIva     Boolean      @default(false)
  porcentajeRetencionIva Int?
  agenteRetencionIslr    Boolean      @default(false)
  activa                 Boolean      @default(true)
  creadaEn               DateTime     @default(now())
  actualizadaEn          DateTime     @default(now())

  usuarios            UsuarioEmpresa[]
  productos           Producto[]
  listasPrecio        ListaPrecio[]
  demandasNoAtendidas DemandaNoAtendida[]
  cuentasTesoreria    CuentaTesoreria[]
  conciliaciones      ConciliacionBancaria[]

  @@unique([organizacionId, codigo])
}

// A que empresas entra cada usuario. Un usuario sin filas aca entra a todas
// las de su organizacion (asi siguen funcionando los usuarios de hoy).
model UsuarioEmpresa {
  usuarioId String
  usuario   Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaId String
  empresa   EmpresaFiscal @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@id([usuarioId, empresaId])
}

// Catalogo de permisos de los modulos nuevos ("ventas.facturar"). Los
// modulos de hoy siguen cerrados por rol (ROUTERS_POR_ROL en main.py).
model Permiso {
  codigo      String           @id
  modulo      String
  descripcion String
  roles       RolPermiso[]
  usuarios    UsuarioPermiso[]
}

// Los permisos que trae cada rol (plantilla). ADMIN los tiene todos sin
// necesidad de filas.
model RolPermiso {
  rol           RolUsuario
  permisoCodigo String
  permiso       Permiso    @relation(fields: [permisoCodigo], references: [codigo], onDelete: Cascade)

  @@id([rol, permisoCodigo])
}

// Permisos sueltos para un usuario, ademas de los de su rol.
model UsuarioPermiso {
  usuarioId     String
  usuario       Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  permisoCodigo String
  permiso       Permiso @relation(fields: [permisoCodigo], references: [codigo], onDelete: Cascade)

  @@id([usuarioId, permisoCodigo])
}

// ---------- Catalogo (fase 0) ----------

// Alicuotas con vigencia: un cambio de tasa no reescribe los documentos
// viejos (cada documento guarda el porcentaje con que se emitio).
model Impuesto {
  id             String    @id @default(cuid())
  organizacionId String    @default("org-principal")
  // IVA_GENERAL | IVA_REDUCIDO | IVA_ADICIONAL | EXENTO
  codigo         String
  nombre         String
  porcentaje     Decimal   @db.Decimal(6, 2)
  vigenteDesde   DateTime  @db.Date
  vigenteHasta   DateTime? @db.Date

  @@unique([organizacionId, codigo, vigenteDesde])
}

// El producto que se vende. Se llena desde VentaProducto (el extracto) y se
// mantiene aca despues del corte. El codigo es numerico porque es el mismo
// del sistema de ventas y Venta.codigoProducto es BigInt.
model Producto {
  id              String        @id @default(cuid())
  organizacionId  String        @default("org-principal")
  empresaId       String
  empresa         EmpresaFiscal @relation(fields: [empresaId], references: [id])
  codigo          BigInt
  nombre          String
  grupo           String?
  codigoProveedor String?
  unidadesPorCaja Int           @default(1)
  litrosPorUnidad Decimal?      @db.Decimal(12, 4)
  pesoCajaKg      Decimal?      @db.Decimal(10, 3)
  impuestoCodigo  String        @default("IVA_GENERAL")
  requiereFrio                Boolean       @default(true)
  manejaLote                  Boolean       @default(true)
  activo                      Boolean       @default(true)
  // ---- Tres tipos de costos por caja (modulo Inventario y Costos) ----
  // 1. Ultimo costo registrado (reposicion / ultima compra).
  ultimoCostoCajaUsd          Decimal?      @db.Decimal(14, 4)
  ultimoCostoCajaBs           Decimal?      @db.Decimal(20, 4)
  // 2. Costo promedio ponderado movil (SENIAT - Art. 177 RISLR).
  costoPromedioCajaUsd        Decimal?      @db.Decimal(14, 4)
  costoPromedioCajaBs         Decimal?      @db.Decimal(20, 4)
  // 3. Costo presupuestario configurable (manual o % sobre ultimo/promedio).
  costoPresupuestarioCajaUsd  Decimal?      @db.Decimal(14, 4)
  // MANUAL | SOBRE_ULTIMO | SOBRE_PROMEDIO
  modoPresupuestario          String        @default("MANUAL")
  porcentajePresupuestario    Decimal?      @db.Decimal(7, 2)
  costosActualizadosEn        DateTime?
  creadoEn                    DateTime      @default(now())
  actualizadoEn               DateTime      @default(now())

  precios             ListaPrecioItem[]
  demandasNoAtendidas DemandaNoAtendida[]
  historialCostos     HistorialCostoProducto[]

  @@unique([empresaId, codigo])
}

// Listas de precio en USD. El codigo es el de VentaCliente.listaPrecio
// (el cliente la trae en Cliente.listaPrecioCodigo).
model ListaPrecio {
  id                  String            @id @default(cuid())
  organizacionId      String            @default("org-principal")
  empresaId           String
  empresa             EmpresaFiscal     @relation(fields: [empresaId], references: [id])
  codigo              String
  nombre              String
  activa              Boolean           @default(true)
  // ULTIMO | PROMEDIO | PRESUPUESTARIO
  baseCostoPorDefecto String            @default("ULTIMO")
  margenObjetivoPct   Decimal?          @db.Decimal(6, 2)
  // SOBRE_COSTO: precio = costo * (1 + m/100) | SOBRE_VENTA: precio = costo / (1 - m/100)
  metodoMargen        String            @default("SOBRE_COSTO")
  items               ListaPrecioItem[]

  @@unique([empresaId, codigo])
}

model ListaPrecioItem {
  id               String      @id @default(cuid())
  listaId          String
  lista            ListaPrecio @relation(fields: [listaId], references: [id], onDelete: Cascade)
  productoId       String
  producto         Producto    @relation(fields: [productoId], references: [id], onDelete: Cascade)
  precioCajaUsd    Decimal     @db.Decimal(14, 4)
  margenPct        Decimal?    @db.Decimal(7, 2)
  // ULTIMO | PROMEDIO | PRESUPUESTARIO | MANUAL
  baseCostoUsada   String?
  precioFijo       Boolean     @default(true)
  actualizadoEn    DateTime    @default(now())
  actualizadoPorId String?

  @@unique([listaId, productoId])
}

// ---------- Numeracion, bitacora y cola de tareas (fase 0) ----------

// El siguiente numero de cada tipo de documento por empresa. Se toma con
// SELECT ... FOR UPDATE dentro de la misma transaccion que crea el
// documento: sin saltos y sin choques entre usuarios (ver
// app/services/correlativo.py). core/numero.py sigue para despachos y rutas.
model Correlativo {
  empresaId String
  // FA | NE | NC | ND | PEDIDO
  tipo      String
  serie     String @default("")
  siguiente BigInt @default(1)

  @@id([empresaId, tipo, serie])
}

// Quien hizo que y cuando, con el antes y el despues. Solo se agregan filas:
// un trigger de la migracion rechaza UPDATE y DELETE.
model Bitacora {
  id             BigInt   @id @default(autoincrement())
  organizacionId String   @default("org-principal")
  fecha          DateTime @default(now())
  usuarioId      String?
  entidad        String
  entidadId      String
  accion         String
  antes          Json?
  despues        Json?

  @@index([entidad, entidadId])
  @@index([fecha])
}

// Cola de trabajos en segundo plano (emitir en la imprenta digital, PDFs,
// correos). Se toman con FOR UPDATE SKIP LOCKED (ver app/services/tareas.py).
model Tarea {
  id             String    @id @default(cuid())
  organizacionId String    @default("org-principal")
  tipo           String
  datos          Json
  // Evita encolar dos veces lo mismo (p. ej. "emitir:<documentoId>").
  claveUnica     String?   @unique
  // PENDIENTE | EN_CURSO | HECHA | FALLIDA
  estado         String    @default("PENDIENTE")
  intentos       Int       @default(0)
  maxIntentos    Int       @default(5)
  ejecutarDesde  DateTime  @default(now())
  ultimoError    String?
  creadaEn       DateTime  @default(now())
  terminadaEn    DateTime?

  @@index([estado, ejecutarDesde])
}

// ---------- Sistema administrativo: ventas e inventario (fase 1) ----------

enum EstadoPedido {
  BORRADOR
  CONFIRMADO
  FACTURADO
  ANULADO
}

enum TipoDocumentoVenta {
  FA // factura
  NE // nota de entrega
  NC // nota de credito
  ND // nota de debito
}

enum EstadoDocumentoVenta {
  BORRADOR
  EN_EMISION // en la cola de la imprenta digital
  EMITIDA
  RECHAZADA // la imprenta lo rechazo: se corrige y se emite otro
}

// Un pedido del cliente. El id lo puede generar quien lo crea (la app del
// vendedor sin senal): reenviar el mismo pedido no lo duplica.
model Pedido {
  id                String       @id
  organizacionId    String       @default("org-principal")
  empresaId         String
  numero            String
  clienteId         String
  almacenId         String
  vendedorId        String?
  // WEB | APP | PORTAL
  origen            String       @default("WEB")
  estado            EstadoPedido @default(BORRADOR)
  listaPrecioCodigo String?
  notas             String?
  creadoPorId       String
  creadoEn          DateTime     @default(now())
  confirmadoEn      DateTime?
  anuladoEn         DateTime?
  motivoAnulacion   String?

  items               PedidoItem[]
  demandasNoAtendidas DemandaNoAtendida[]

  @@unique([empresaId, numero])
  @@index([empresaId, estado])
  @@index([clienteId])
}

model DemandaNoAtendida {
  id               String        @id @default(cuid())
  organizacionId   String        @default("org-principal")
  organizacion     Organizacion  @relation(fields: [organizacionId], references: [id])
  empresaId        String
  empresa          EmpresaFiscal @relation(fields: [empresaId], references: [id])
  almacenId        String
  almacen          Almacen       @relation(fields: [almacenId], references: [id])
  clienteId        String
  cliente          Cliente       @relation(fields: [clienteId], references: [id])
  vendedorId       String?
  vendedor         Usuario?      @relation("DemandaNoAtendidaVendedor", fields: [vendedorId], references: [id], onDelete: SetNull)
  productoId       String
  producto         Producto      @relation(fields: [productoId], references: [id])
  pedidoId         String?
  pedido           Pedido?       @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  cajasSolicitadas Decimal       @db.Decimal(14, 3)
  cajasDisponibles Decimal       @db.Decimal(14, 3)
  cajasFaltantes   Decimal       @db.Decimal(14, 3)
  motivo           String
  fecha            DateTime      @default(now()) @db.Timestamptz

  @@index([empresaId, fecha])
  @@index([vendedorId, fecha])
  @@index([productoId, fecha])
  @@index([clienteId])
  @@index([pedidoId])
}

model PedidoItem {
  id            String  @id @default(cuid())
  pedidoId      String
  pedido        Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId    String
  cajas         Decimal @db.Decimal(14, 3)
  precioCajaUsd Decimal @db.Decimal(14, 4)
  descuentoPct  Decimal @default(0) @db.Decimal(5, 2)
}

// Factura, nota de entrega, nota de credito o de debito. Emitida no se
// edita: se corrige con una nota. Guarda la ficha fiscal del cliente, la
// tasa y los porcentajes con que salio.
model DocumentoVenta {
  id                            String               @id @default(cuid())
  organizacionId                String               @default("org-principal")
  empresaId                     String
  tipo                          TipoDocumentoVenta
  // Numero interno (Correlativo); null hasta que se emite.
  numero                        String?
  // El que asigna la imprenta digital al emitir.
  numeroControl                 String?
  estado                        EstadoDocumentoVenta @default(BORRADOR)
  pedidoId                      String?
  documentoAfectadoId           String?
  documentoAfectado             DocumentoVenta?      @relation("NotasDelDocumento", fields: [documentoAfectadoId], references: [id])
  notas                         DocumentoVenta[]     @relation("NotasDelDocumento")
  motivo                        String?
  // NC: si la mercancia vuelve al inventario.
  devuelveInventario            Boolean              @default(false)
  clienteId                     String
  almacenId                     String?
  clienteRif                    String?
  clienteRazonSocial            String?
  clienteDomicilio              String?
  clienteContribuyenteEspecial  Boolean              @default(false)
  clientePorcentajeRetencionIva Int?
  fechaEmision                  DateTime?            @db.Date
  vencimiento                   DateTime?            @db.Date
  tasa                          Decimal?             @db.Decimal(20, 8)
  fechaTasa                     DateTime?            @db.Date
  pagoEnDivisas                 Boolean              @default(false)
  igtfPorcentaje                Decimal              @default(0) @db.Decimal(5, 2)
  baseImponibleUsd              Decimal              @default(0) @db.Decimal(20, 2)
  exentoUsd                     Decimal              @default(0) @db.Decimal(20, 2)
  ivaUsd                        Decimal              @default(0) @db.Decimal(20, 2)
  igtfUsd                       Decimal              @default(0) @db.Decimal(20, 2)
  totalUsd                      Decimal              @default(0) @db.Decimal(20, 2)
  baseImponibleBs               Decimal              @default(0) @db.Decimal(20, 2)
  exentoBs                      Decimal              @default(0) @db.Decimal(20, 2)
  ivaBs                         Decimal              @default(0) @db.Decimal(20, 2)
  igtfBs                        Decimal              @default(0) @db.Decimal(20, 2)
  totalBs                       Decimal              @default(0) @db.Decimal(20, 2)
  // Desglose por alicuota: [{codigo, porcentaje, baseUsd, ivaUsd, baseBs, ivaBs}]
  impuestos                     Json?
  emisorFiscal                  String?
  respuestaEmisor               Json?
  errorEmision                  String?
  creadoPorId                   String
  creadoEn                      DateTime             @default(now())
  emitidoEn                     DateTime?

  items DocumentoVentaItem[]

  @@unique([empresaId, tipo, numero])
  @@index([empresaId, fechaEmision])
  @@index([clienteId])
  @@index([pedidoId])
}

model DocumentoVentaItem {
  id                 String         @id @default(cuid())
  documentoId        String
  documento          DocumentoVenta @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  productoId         String
  codigoProducto     BigInt
  descripcion        String
  cajas              Decimal        @db.Decimal(14, 3)
  unidadesPorCaja    Int
  precioCajaUsd      Decimal        @db.Decimal(14, 4)
  descuentoPct       Decimal        @default(0) @db.Decimal(5, 2)
  impuestoCodigo     String
  porcentajeImpuesto Decimal        @db.Decimal(6, 2)
  subtotalUsd        Decimal        @db.Decimal(20, 2)
}

// Un lote de un producto. Los productos sin lote usan uno llamado
// "SIN-LOTE" (asi toda existencia tiene lote y la llave es simple).
model Lote {
  id          String    @id @default(cuid())
  productoId  String
  numero      String
  vencimiento DateTime? @db.Date
  creadoEn    DateTime  @default(now())

  @@unique([productoId, numero])
}

// Existencia por almacen, producto y lote. Se mueve solo con
// MovimientoInventario (ver app/services/inventario.py), en la misma
// transaccion.
model Existencia {
  id         String  @id @default(cuid())
  almacenId  String
  productoId String
  loteId     String
  cajas      Decimal @default(0) @db.Decimal(14, 3)

  @@unique([almacenId, productoId, loteId])
  @@index([productoId])
}

// Cada entrada o salida. Solo se agregan filas (Kardex valorado Art. 177 RISLR).
model MovimientoInventario {
  id                         BigInt   @id @default(autoincrement())
  organizacionId             String   @default("org-principal")
  empresaId                  String
  almacenId                  String
  productoId                 String
  loteId                     String
  // ENTRADA | SALIDA_VENTA | DEVOLUCION | RETIRO | AUTOCONSUMO | TRASLADO_SALIDA | TRASLADO_ENTRADA | AJUSTE
  tipo                       String
  // Con signo: positivo entra, negativo sale.
  cajas                      Decimal  @db.Decimal(14, 3)
  // Valoracion por caja y snapshot de costo promedio ponderado (SENIAT).
  costoUnitarioUsd           Decimal? @db.Decimal(14, 4)
  costoUnitarioBs            Decimal? @db.Decimal(20, 4)
  tasa                       Decimal? @db.Decimal(20, 8)
  valorTotalUsd              Decimal? @db.Decimal(20, 2)
  valorTotalBs               Decimal? @db.Decimal(20, 2)
  saldoCajasEmpresa          Decimal? @db.Decimal(14, 3)
  costoPromedioResultanteUsd Decimal? @db.Decimal(14, 4)
  costoPromedioResultanteBs  Decimal? @db.Decimal(20, 4)
  proveedor                  String?
  numeroFacturaCompra        String?
  documentoVentaId           String?
  ajusteId                   String?
  referencia                 String?
  usuarioId                  String?
  fecha                      DateTime @default(now())

  @@index([productoId, fecha])
  @@index([empresaId, fecha])
  @@index([documentoVentaId])
}

// Auditoria de cambios en los 3 costos de un producto.
model HistorialCostoProducto {
  id               BigInt   @id @default(autoincrement())
  organizacionId   String   @default("org-principal")
  empresaId        String
  productoId       String
  producto         Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  // ULTIMO | PROMEDIO | PRESUPUESTARIO
  tipoCosto        String
  costoAnteriorUsd Decimal? @db.Decimal(14, 4)
  costoNuevoUsd    Decimal  @db.Decimal(14, 4)
  costoNuevoBs     Decimal? @db.Decimal(20, 4)
  tasa             Decimal? @db.Decimal(20, 8)
  motivo           String?
  movimientoId     BigInt?
  usuarioId        String?
  fecha            DateTime @default(now())

  @@index([productoId, fecha])
  @@index([empresaId, tipoCosto, fecha])
}

// ---------- Sistema administrativo: bancos y flujo de caja ----------

model CuentaTesoreria {
  id                String         @id @default(cuid())
  organizacionId    String         @default("org-principal")
  empresaId         String
  empresa           EmpresaFiscal  @relation(fields: [empresaId], references: [id])
  nombre            String
  // BANCO_CORRIENTE | BANCO_AHORRO | BANCO_CUSTODIA_USD | CAJA_EFECTIVO | BILLETERA_DIGITAL
  tipo              String
  // VES | USD
  moneda            String
  bancoCodigo       String?
  numeroCuenta      String?
  titular           String?
  rif               String?
  saldoInicial      Decimal        @default(0) @db.Decimal(20, 2)
  fechaSaldoInicial DateTime       @db.Date
  saldoActual       Decimal        @default(0) @db.Decimal(20, 2)
  // Enlace opcional a CuentaBancariaEmpresa (portal de cobranzas).
  cuentaPortalId    String?
  activa            Boolean        @default(true)
  creadaEn          DateTime       @default(now())
  actualizadaEn     DateTime       @default(now())

  movimientos    MovimientoBancario[]
  conciliaciones ConciliacionBancaria[]

  @@index([empresaId, activa])
}

model MovimientoBancario {
  id                    BigInt          @id @default(autoincrement())
  organizacionId        String          @default("org-principal")
  empresaId             String
  cuentaId              String
  cuenta                CuentaTesoreria @relation(fields: [cuentaId], references: [id])
  fecha                 DateTime        @db.Date
  // INGRESO | EGRESO | TRANSFERENCIA_SALIDA | TRANSFERENCIA_ENTRADA | AJUSTE
  tipo                  String
  // TRANSFERENCIA | PAGO_MOVIL | EFECTIVO | DIVISAS | ZELLE | CHEQUE | POS | COMISION_IGTF | OTRO
  metodo                String
  // COBRANZA_CLIENTES | COMPRA_INVENTARIO | GASTO_OPERATIVO | NOMINA | DELIVERY | IMPUESTOS_IGTF | TRASPASO | APORTE_CAPITAL | OTRO
  categoria             String
  concepto              String
  tercero               String?
  referencia            String?
  // Con signo en la moneda de la cuenta (+ ingreso, - egreso).
  monto                 Decimal         @db.Decimal(20, 2)
  tasa                  Decimal?        @db.Decimal(20, 8)
  montoUsd              Decimal         @db.Decimal(20, 2)
  montoBs               Decimal?        @db.Decimal(20, 2)
  saldoResultante       Decimal         @db.Decimal(20, 2)
  transferenciaGrupoId  String?
  pagoId                String?
  gastoId               String?
  liquidacionDeliveryId String?
  conciliado            Boolean         @default(false)
  conciliadoEn          DateTime?
  conciliadoPorId       String?
  anuladoEn             DateTime?
  anuladoPorId          String?
  motivoAnulacion       String?
  reversoDeId           BigInt?
  usuarioId             String?
  creadoEn              DateTime        @default(now())

  @@index([cuentaId, fecha])
  @@index([empresaId, fecha])
  @@index([transferenciaGrupoId])
  @@index([pagoId])
  @@index([gastoId])
}

model ConciliacionBancaria {
  id                 String          @id @default(cuid())
  organizacionId     String          @default("org-principal")
  empresaId          String
  empresa            EmpresaFiscal   @relation(fields: [empresaId], references: [id])
  cuentaId           String
  cuenta             CuentaTesoreria @relation(fields: [cuentaId], references: [id])
  archivo            String
  periodoDesde       DateTime        @db.Date
  periodoHasta       DateTime        @db.Date
  saldoExtractoFinal Decimal?        @db.Decimal(20, 2)
  // BORRADOR | CONFIRMADA
  estado             String          @default("BORRADOR")
  resumen            Json
  lineas             Json
  creadaPorId        String
  creadaEn           DateTime        @default(now())
  confirmadaPorId    String?
  confirmadaEn       DateTime?

  @@index([cuentaId, creadaEn])
  @@index([empresaId, creadaEn])
}

// Ajuste de inventario: lo propone uno y lo aprueba otro con permiso.
model AjusteInventario {
  id             String    @id @default(cuid())
  organizacionId String    @default("org-principal")
  empresaId      String
  almacenId      String
  // PROPUESTO | APROBADO | RECHAZADO
  estado         String    @default("PROPUESTO")
  motivo         String
  // [{productoId, loteId, cajas}] con signo
  items          Json
  propuestoPorId String
  resueltoPorId  String?
  creadoEn       DateTime  @default(now())
  resueltoEn     DateTime?
}

// ---------- Gastos (estado de resultados) ----------
//
// Los gastos de cada empresa llegan en un Excel (pedido del cliente,
// 2026-11-09). Cada archivo es una carga: se revisa en una vista previa, se
// confirma y se puede revertir, como las ventas. Con las ventas y el costo de
// los indicadores dan el resultado de las operaciones (ver
// app/services/gastos.py).

enum EstadoCargaGasto {
  CONFIRMADA
  REVERTIDA
}

model GastoCarga {
  id           String           @id @default(cuid())
  empresa      Empresa
  archivo      String
  periodoDesde DateTime         @db.Date
  periodoHasta DateTime         @db.Date
  filas        Int
  totalUsd     Decimal          @db.Decimal(20, 2)
  estado       EstadoCargaGasto @default(CONFIRMADA)
  subidaEn     DateTime         @default(now())
  subidaPorId  String
  subidaPor    Usuario          @relation(fields: [subidaPorId], references: [id])
  revertidaEn  DateTime?
  gastos       Gasto[]

  @@index([empresa, estado])
}

model Gasto {
  id          String     @id @default(cuid())
  cargaId     String
  carga       GastoCarga @relation(fields: [cargaId], references: [id], onDelete: Cascade)
  empresa     Empresa
  fecha       DateTime   @db.Date
  categoria   String
  descripcion              String?
  proveedor                String?
  tipoDocumento            String?
  numeroDocumentoProveedor String?
  referencia               String?
  // El monto en USD es el que cuenta en el resultado. Si el Excel lo trae en
  // Bs, se convierte con la tasa BCV de esa fecha (la guardada en tasa).
  montoUsd                 Decimal    @db.Decimal(20, 2)
  montoBs                  Decimal?   @db.Decimal(20, 2)
  // USD | BS: en que moneda venia en el Excel.
  moneda                   String
  tasa                     Decimal?   @db.Decimal(20, 8)
  banco                    String?
  retencion                String?

  @@index([empresa, fecha])
  @@index([cargaId])
}

// ---------- App movil de campo ----------
//
// La jornada del repartidor: desde que pulsa «Iniciar jornada» en la app
// hasta «Terminar jornada». Mientras esta abierta, la app manda su ubicacion
// en segundo plano (pedido del cliente, 2026-11-10). Una que nadie cierra se
// cierra sola (ver app/services/jornadas.py).
model Jornada {
  id          String     @id @default(cuid())
  usuarioId   String
  usuario     Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  vehiculoId  String?
  iniciadaEn  DateTime   @default(now())
  terminadaEn DateTime?
  // MANUAL | AUTOMATICO
  cierre      String?
  posiciones  Posicion[]

  @@index([usuarioId, iniciadaEn])
}

// Cada punto que manda la app. `tomadaEn` es la hora del telefono corregida
// con el reloj del servidor al recibir el lote. La llave es la hora cruda del
// telefono (`tomadaTelefonoMs`): la corregida cambia unos milisegundos entre
// un envio y su reintento (depende de la red), la cruda no. Asi reenviar un
// lote no duplica.
model Posicion {
  id               BigInt   @id @default(autoincrement())
  usuarioId        String
  jornadaId        String
  jornada          Jornada  @relation(fields: [jornadaId], references: [id], onDelete: Cascade)
  rutaId           String?
  lat              Float
  lng              Float
  precisionM       Float?
  // m/s y grados, como los da el GPS.
  velocidad        Float?
  rumbo            Float?
  // 0..1
  bateria          Float?
  tomadaEn         DateTime
  tomadaTelefonoMs BigInt
  recibidaEn       DateTime @default(now())

  @@unique([usuarioId, tomadaTelefonoMs])
  @@index([jornadaId, tomadaEn])
  @@index([rutaId, tomadaEn])
}

// La ultima posicion de cada usuario, para el mapa de seguimiento sin
// recorrer Posicion.
model UltimaPosicion {
  usuarioId  String   @id
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  jornadaId  String
  rutaId     String?
  lat        Float
  lng        Float
  precisionM Float?
  velocidad  Float?
  rumbo      Float?
  bateria    Float?
  tomadaEn   DateTime
  recibidaEn DateTime @default(now())
}
