// Prisma es la fuente de verdad del esquema/migraciones. El backend Python
// (ver backend/app/core/db.py) accede a Postgres directo con psycopg + SQL
// plano contra las tablas que este schema crea via "prisma migrate" — no usa
// prisma-client-py (su motor bundleado todavia exige "url" dentro de
// datasource, que Prisma 7 ya no permite aca; la conexion real se configura
// en prisma.config.ts via DATABASE_URL). El generator "prisma-client-js" de
// abajo solo produce tipos de TypeScript para el frontend.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ---------- Enums ----------

enum RolUsuario {
  ADMIN
  DESPACHOS
  APROBADOR
  REPARTIDOR
}

enum Empresa {
  ISVAN
  TRALOG
}

enum AccionRevision {
  APROBADA
  RECHAZADA
}

enum EstadoDespacho {
  BORRADOR
  PENDIENTE_APROBACION
  APROBADO
  RECHAZADO
  EN_PREPARACION
  EN_TRANSITO
  ENTREGADO
  CANCELADO
}

enum EstadoRuta {
  PLANIFICADA
  EN_TRANSITO
  COMPLETADA
  CANCELADA
}

enum TipoVehiculo {
  CAMION_REFRIGERADO
  CAMIONETA
  MOTO
}

enum EstadoVehiculo {
  FUNCIONAL
  EN_MANTENIMIENTO
  FUERA_DE_SERVICIO
}

// ---------- Usuarios / autenticacion ----------

model Usuario {
  id           String     @id @default(cuid())
  nombre       String
  email        String     @unique
  passwordHash String
  rol          RolUsuario
  avatarUrl    String?
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())

  // Solo tiene sentido para el rol REPARTIDOR: el vehiculo que maneja. Es
  // lo que acota lo que ese usuario puede ver — su vehiculo lleva una sola
  // ruta activa a la vez, y esa es la unica ruta a la que tiene acceso (ver
  // backend/app/core/permisos.py). Nullable porque los demas roles no lo
  // usan, y porque un repartidor puede quedar sin vehiculo asignado.
  vehiculoAsignadoId String?
  vehiculoAsignado   Vehiculo? @relation("ConductorDelVehiculo", fields: [vehiculoAsignadoId], references: [id])

  despachosCreados     Despacho[]           @relation("DespachosCreadosPor")
  aprobacionesDespacho DespachoAprobacion[]
  rutasCreadas         Ruta[]
  sesiones             Sesion[]
}

// Sesiones respaldadas en BD (no JWT): revocar una sesion es borrar la fila,
// lo cual conviene para un equipo pequeno donde puede hacer falta cerrar la
// sesion de alguien a mano. El token crudo nunca se guarda, solo su hash.
model Sesion {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  tokenHash String   @unique
  creadoEn  DateTime @default(now())
  expiraEn  DateTime
}

// ---------- Almacen y flota ----------

model Almacen {
  id            String  @id @default(cuid())
  nombre        String
  tipo          String // "Centro de Distribucion" | "Planta" | "Tienda"
  direccion     String
  ciudad        String
  lat           Float
  lng           Float
  esFrigorifico Boolean @default(true)

  despachosOrigen Despacho[] @relation("DespachoOrigen")
  vehiculos       Vehiculo[]
  rutas           Ruta[]
}

model Vehiculo {
  id                 String         @id @default(cuid())
  placa              String         @unique
  tipo               TipoVehiculo
  capacidadKg        Float
  tieneRefrigeracion Boolean        @default(true)
  estado             EstadoVehiculo @default(FUNCIONAL)
  almacenBaseId      String
  almacenBase        Almacen        @relation(fields: [almacenBaseId], references: [id])
  conductorNombre    String?
  ultimaRevision     DateTime?
  // Costo operativo por kilometro (USD) usado para estimar el costo de una
  // ruta sugerida. Opcional: si no esta cargado se usa un valor de
  // referencia por tipo de vehiculo (ver plan_rutas.COSTO_POR_KM_POR_TIPO).
  costoPorKm         Float?

  rutas       Ruta[]
  conductores Usuario[] @relation("ConductorDelVehiculo")
}

// ---------- Clientes ----------

// El mismo codigo puede referirse a clientes distintos segun la empresa
// (ISVAN / TRALOG comparten almacen y flota pero no su cartera de clientes),
// asi que la llave de negocio es (empresa, codigo), no el codigo solo.
model Cliente {
  id        String  @id @default(cuid())
  empresa   Empresa
  codigo    String // ej. "CLI-0001", unico solo dentro de su empresa
  nombre    String
  tipo      String // "Tienda" | "Distribuidor" | "Consumidor final"
  direccion String
  ciudad    String
  lat       Float?
  lng       Float?
  // Obligatorio: lo usan los despachadores para contactar al cliente.
  telefono  String
  email     String?
  // Ruta comercial (de venta/reparto) a la que el negocio asigna al cliente,
  // p.ej. "R-07". No es la Ruta (viaje) de este sistema: es un dato del
  // cliente que viene del extracto de ventas y se usa como criterio de peso
  // al sugerir como agrupar despachos en un viaje (ver
  // backend/app/services/plan_rutas.py). Opcional porque hay clientes
  // cargados antes de que existiera la columna.
  rutaComercial String?

  despachos Despacho[] @relation("DespachoDestino")

  @@unique([empresa, codigo])
}

// ---------- Despachos ----------

model Despacho {
  id                   String         @id @default(cuid())
  numero               String         @unique // ej. "D-0001"
  // Numero de factura/nota de entrega del documento origen (Excel o carga
  // manual). Llave real de agrupacion e idempotencia de la importacion: cada
  // documento subido debe ser nuevo, nunca repetir uno ya cargado.
  numeroDocumento      String         @unique
  origenId             String
  origen               Almacen        @relation("DespachoOrigen", fields: [origenId], references: [id])
  destinoClienteId     String
  destinoCliente       Cliente        @relation("DespachoDestino", fields: [destinoClienteId], references: [id])
  creadoPorId          String
  creadoPor            Usuario        @relation("DespachosCreadosPor", fields: [creadoPorId], references: [id])
  estado               EstadoDespacho @default(BORRADOR)
  fechaCreacion        DateTime       @default(now())
  fechaEstimadaEntrega DateTime?

  // El vehiculo se asigna a nivel de Ruta (un vehiculo puede llevar varios
  // despachos en un mismo viaje), no por despacho suelto.
  rutaId      String?
  ruta        Ruta?   @relation(fields: [rutaId], references: [id])
  ordenEnRuta Int? // posicion de esta parada dentro de la ruta, calculada por el TSP

  // Marcas de tiempo que pone el repartidor en la calle, para medir su
  // rendimiento: cuando llego al cliente y cuando termino de entregar. La
  // diferencia entre ambas es el tiempo de atencion de esa parada; entre la
  // entrega anterior y esta llegada, el tiempo de traslado.
  llegadaEn   DateTime?
  entregadoEn DateTime?

  items         DespachoItem[]
  aprobaciones  DespachoAprobacion[]
  puntosEntrega RutaPunto[] // puntos de la ruta marcados como la parada de este despacho
}

model DespachoItem {
  id         String   @id @default(cuid())
  despachoId String
  despacho   Despacho @relation(fields: [despachoId], references: [id])
  // Texto libre (viene del Excel o de carga manual) — ya no hay catalogo de
  // productos: cada fila trae su propia descripcion, cantidad y peso.
  descripcion String
  // Lo que el documento origen pedia originalmente (se copia y se congela al
  // crear el despacho). "cantidad" es lo que realmente se va a despachar: el
  // coordinador puede ajustarla a mano mientras el despacho no haya salido
  // del almacen.
  cantidadSolicitada Int
  cantidad           Int
  pesoUnitarioKg     Float
  requiereFrio       Boolean @default(true)
}

// Auditoria de la aprobacion/rechazo del despacho.
model DespachoAprobacion {
  id         String         @id @default(cuid())
  despachoId String
  despacho   Despacho       @relation(fields: [despachoId], references: [id])
  usuarioId  String
  usuario    Usuario        @relation(fields: [usuarioId], references: [id])
  accion     AccionRevision
  comentario String?
  fecha      DateTime       @default(now())
}

// ---------- Rutas (multi-parada) ----------

// Un viaje de un vehiculo que agrupa varios despachos (uno por cliente),
// visitados en el orden que calcula el optimizador (TSP) a partir de
// Almacen Catia. Reemplaza el calculo "1 despacho = 1 tramo" de antes.
model Ruta {
  id               String     @id @default(cuid())
  numero           String     @unique // ej. "R-0001"
  vehiculoId       String
  vehiculo         Vehiculo   @relation(fields: [vehiculoId], references: [id])
  origenId         String
  origen           Almacen    @relation(fields: [origenId], references: [id])
  creadoPorId      String
  creadoPor        Usuario    @relation(fields: [creadoPorId], references: [id])
  estado           EstadoRuta @default(PLANIFICADA)
  fechaCreacion    DateTime   @default(now())
  // Cuando el vehiculo salio del almacen y cuando se entrego la ultima
  // parada. Con estas dos y las marcas de cada Despacho se arma el reporte
  // de rendimiento del viaje (duracion real vs estimada, tiempo hasta la
  // primera parada, tiempo entre paradas).
  iniciadaEn       DateTime?
  completadaEn     DateTime?
  distanciaTotalKm Float?
  tiempoTotalMin   Int?

  despachos Despacho[]
  puntos    RutaPunto[]
}

// Waypoints de la geometria de una Ruta multi-parada, usados tanto para
// dibujar el trazado calculado como para el seguimiento en vivo.
// paradaDespachoId marca los puntos que corresponden a la llegada/entrega en
// un cliente especifico (a diferencia de los puntos intermedios del trazado).
model RutaPunto {
  id               String    @id @default(cuid())
  rutaId           String
  ruta             Ruta      @relation(fields: [rutaId], references: [id])
  orden            Int
  lat              Float
  lng              Float
  estado           String // "salida" | "en_ruta" | "parada" | "entregado"
  timestamp        DateTime
  descripcion      String?
  paradaDespachoId String?
  paradaDespacho   Despacho? @relation(fields: [paradaDespachoId], references: [id])
}
